---
import { Icon } from 'astro-icon/components';
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import { PROJECTS } from '../../../data/content';
import { getLangFromUrl, useTranslations, getRelativeLocaleUrl } from '../../../i18n/utils';
import type { Project } from '../../../types';

export function getStaticPaths() {
  return PROJECTS.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const renderArchitecturalDiagram = (diagramType: string) => {
  switch (diagramType) {
    case 'packing':
      return `
        <div class="bg-surface-2 border border-border rounded-lg p-3 sm:p-4 font-mono text-xs overflow-x-auto">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-2 mb-3 border-b border-border text-[11px] text-text-dim gap-1">
            <span>// OR-Tools CP-SAT 2D Berth Optimization</span>
            <span class="text-accent font-semibold">PostGIS ➔ Solver ➔ Dock Grid</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-center text-[11px]">
            <div class="p-2.5 sm:p-3 bg-surface border border-border rounded">
              <span class="text-text-dim block mb-1">1. Fleet Input</span>
              <span class="text-text font-medium">Length, Beam, Draft, Dates</span>
            </div>
            <div class="p-2.5 sm:p-3 bg-accent-soft border border-border rounded text-accent">
              <span class="text-accent font-bold block mb-1">2. CP-SAT Solver</span>
              <span class="font-semibold">2D Bin-Packing + Buffers</span>
            </div>
            <div class="p-2.5 sm:p-3 bg-surface border border-border rounded">
              <span class="text-text-dim block mb-1">3. Deterministic Layout</span>
              <span class="text-text font-medium">Zero Overlap, +22% Capacity</span>
            </div>
          </div>
        </div>
      `;
    case 'agent_stream':
      return `
        <div class="bg-surface-2 border border-border rounded-lg p-3 sm:p-4 font-mono text-xs overflow-x-auto">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-2 mb-3 border-b border-border text-[11px] text-text-dim gap-1">
            <span>// NutriFit Event-Driven Streaming Pipeline</span>
            <span class="text-accent font-semibold">Celery ➔ Redis Pub/Sub ➔ SSE</span>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center text-[10px]">
            <div class="p-2 bg-surface border border-border rounded">
              <span class="text-text-dim block">HTTP / Web</span>
              <span class="text-text font-medium">Django REST</span>
            </div>
            <div class="p-2 bg-accent-soft border border-border rounded text-accent">
              <span class="text-accent font-semibold block">Async Task</span>
              <span>Celery + Gemini</span>
            </div>
            <div class="p-2 bg-surface border border-border rounded">
              <span class="text-text-dim block">Message Bus</span>
              <span class="text-text font-medium">Redis Pub/Sub</span>
            </div>
            <div class="p-2 bg-accent-soft border border-border rounded text-accent">
              <span class="text-accent font-semibold block">Live Stream</span>
              <span>SSE Client Feed</span>
            </div>
          </div>
          <div class="mt-3 p-2 bg-surface border border-border rounded text-[11px] flex flex-col sm:flex-row sm:items-center justify-between gap-1">
            <span class="text-text-dim">${lang === 'it' ? 'Motore kNN Distanza Macronutrienti:' : 'kNN Macronutrient Swap Engine:'}</span>
            <span class="text-accent font-semibold">&lt; 30ms latency (Postgres SQL)</span>
          </div>
        </div>
      `;
    case 'qr_pipeline':
      return `
        <div class="bg-surface-2 border border-border rounded-lg p-3 sm:p-4 font-mono text-xs overflow-x-auto">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-2 mb-3 border-b border-border text-[11px] text-text-dim gap-1">
            <span>// Central Parking Gate Verification Pipeline</span>
            <span class="text-accent font-semibold">Booking ➔ Encrypted QR ➔ WhatsApp</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-center text-[11px]">
            <div class="p-2.5 bg-surface border border-border rounded">
              <span class="text-text-dim block mb-1">Agency Booking</span>
              <span class="text-text font-medium">Flask JWT + ReportLab</span>
            </div>
            <div class="p-2.5 bg-surface border border-border rounded">
              <span class="text-text-dim block mb-1">Instant Dispatch</span>
              <span class="text-accent font-semibold">WhatsApp Cloud API</span>
            </div>
            <div class="p-2.5 bg-accent-soft border border-border rounded text-accent">
              <span class="text-accent font-bold block mb-1">Gate Camera Scan</span>
              <span class="font-semibold">&lt; 0.5s Check-in Validation</span>
            </div>
          </div>
        </div>
      `;
    case 'spi_icmp':
      return `
        <div class="bg-surface-2 border border-border rounded-lg p-3 sm:p-4 font-mono text-xs overflow-x-auto">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-2 mb-3 border-b border-border text-[11px] text-text-dim gap-1">
            <span>// Standalone Hardware Architecture (Bare Metal C++)</span>
            <span class="text-accent font-semibold">ATmega ➔ SPI Bus ➔ ENC28J60 PHY</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-center text-[11px]">
            <div class="p-2.5 bg-surface border border-border rounded">
              <span class="text-text-dim block mb-1">TFT Touch GUI</span>
              <span class="text-text font-medium">Adafruit_GFX (SRAM Opt.)</span>
            </div>
            <div class="p-2.5 bg-accent-soft border border-border rounded text-accent">
              <span class="text-accent font-bold block mb-1">SPI Interfacing</span>
              <span class="font-semibold">Raw Ethernet Frames</span>
            </div>
            <div class="p-2.5 bg-surface border border-border rounded">
              <span class="text-text-dim block mb-1">Diagnostics</span>
              <span class="text-text font-medium">DHCP / ICMP Ping Echo</span>
            </div>
          </div>
        </div>
      `;
    default:
      return `
        <div class="bg-surface-2 border border-border rounded-lg p-3 sm:p-4 font-mono text-xs">
          <div class="flex items-center justify-between text-[11px] text-text-dim mb-2">
            <span>// Pipeline Ingegneristica Standard</span>
            <span class="text-accent font-semibold">Flask + PostgreSQL + Celery</span>
          </div>
          <p class="text-xs text-text">
            ${lang === 'it' 
              ? 'Flusso completamente asincrono con database relazionale, scoring deterministico e reportistica.'
              : 'Fully decoupled asynchronous architecture with relational persistence and deterministic reporting.'}
          </p>
        </div>
      `;
  }
};
---

<Layout lang={lang} title={`${project.title} | Giorgio Di Cristofalo`}>
  <Navbar />
  
  <main class="pt-24 pb-16 sm:pt-32 sm:pb-24 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
    <!-- Breadcrumbs / Back button -->
    <a href={getRelativeLocaleUrl(lang, '/#laboratory')} class="inline-flex items-center space-x-2 text-xs font-mono text-text-dim hover:text-accent transition-colors mb-8 group">
      <Icon name="tabler:arrow-left" class="w-4 h-4 group-hover:-translate-x-1 transition-transform" />
      <span>{lang === 'it' ? 'Torna al Laboratorio' : 'Back to Laboratory'}</span>
    </a>

    <!-- Header -->
    <div class="mb-10 pb-6 border-b border-border relative">
      <div class="flex items-center space-x-2.5 mb-2 flex-wrap gap-y-1">
        <span class="text-[10px] font-mono px-2 py-1 bg-accent-soft text-accent border border-border rounded">
          {typeof project.statusLabel === 'object' ? project.statusLabel[lang] : project.statusLabel}
        </span>
        <span class="text-xs font-mono text-text-dim">
          {project.year}
        </span>
      </div>
      <h1 class="font-bold text-3xl sm:text-5xl text-text leading-tight mb-3">
        {project.title}
      </h1>
      <p class="text-base sm:text-lg text-text-dim font-sans max-w-2xl">
        {typeof project.tagline === 'object' ? project.tagline[lang] : project.tagline}
      </p>
      
      <div class="absolute top-0 right-0 sm:top-2 sm:right-2 flex items-center space-x-2">
        {project.repoUrl && (
          <a
            href={project.repoUrl}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-sm bg-surface text-text border border-border text-xs font-mono hover:border-accent hover:text-accent transition-colors shadow-xs"
          >
            <Icon name="tabler:brand-github" class="w-4 h-4" />
            <span class="hidden sm:inline">GitHub</span>
          </a>
        )}
        {project.demoUrl && (
          <a
            href={project.demoUrl}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-sm bg-accent text-accent-contrast border border-accent text-xs font-mono hover:brightness-110 transition-all shadow-xs"
          >
            <Icon name="tabler:external-link" class="w-4 h-4" />
            <span class="hidden sm:inline">Live Demo</span>
          </a>
        )}
      </div>
    </div>

    <!-- Preview Image -->
    {project.image && (
      <div class="mb-10">
        <div class="w-full bg-surface-2 rounded-xl p-2 sm:p-4 border border-border shadow-sm flex items-center justify-center">
          <div class="relative w-full rounded-lg border border-border shadow-md overflow-hidden flex flex-col bg-surface">
            <div class="h-5 sm:h-6 bg-surface-2 border-b border-border w-full flex items-center px-3 space-x-1.5 sm:space-x-2 shrink-0">
              <div class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-[#FF5F56]"></div>
              <div class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-[#FFBD2E]"></div>
              <div class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-[#27C93F]"></div>
            </div>
            <img src={project.image} alt={project.title} class="w-full h-auto object-cover object-top" loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
    )}

    <!-- Tab Navigation (Client-side via JS) -->
    <div class="flex border-b border-border bg-surface text-xs font-mono overflow-x-auto scrollbar-none mb-8" id="project-tabs">
      <button data-target="overview" class="tab-btn py-3 px-4 border-b-2 border-accent text-accent font-semibold cursor-pointer transition-colors whitespace-nowrap shrink-0">
        {t('modal.tabs.overview')}
      </button>
      <button data-target="architecture" class="tab-btn py-3 px-4 border-b-2 border-transparent text-text-dim hover:text-text cursor-pointer transition-colors whitespace-nowrap shrink-0">
        {t('modal.tabs.architecture')}
      </button>
      <button data-target="stack" class="tab-btn py-3 px-4 border-b-2 border-transparent text-text-dim hover:text-text cursor-pointer transition-colors whitespace-nowrap shrink-0">
        {t('modal.tabs.stack')}
      </button>
    </div>

    <!-- Content Sections -->
    <div class="space-y-6">
      
      <!-- Overview Tab -->
      <div id="tab-overview" class="tab-content block space-y-6">
        <div>
          <h4 class="text-xs font-bold uppercase tracking-widest text-text-dim mb-2 flex items-center space-x-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            <span>{t('modal.problemTag')}</span>
          </h4>
          <div class="bg-surface-2 p-4 sm:p-5 rounded-lg border border-border text-sm text-text leading-relaxed font-sans">
            {typeof project.problem === 'object' ? project.problem[lang] : project.problem}
          </div>
        </div>

        <div>
          <h4 class="text-xs font-bold uppercase tracking-widest text-text-dim mb-2 flex items-center space-x-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            <span>{t('modal.solutionTag')}</span>
          </h4>
          <div class="bg-surface-2 p-4 sm:p-5 rounded-lg border border-border text-sm text-text-dim leading-relaxed font-sans">
            {typeof project.howItWorks === 'object' ? project.howItWorks[lang] : project.howItWorks}
          </div>
        </div>

        <div>
          <h4 class="text-xs font-bold uppercase tracking-widest text-text-dim mb-2 flex items-center space-x-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            <span>{t('modal.whyMattersTag')}</span>
          </h4>
          <div class="bg-surface-2 p-4 sm:p-5 rounded-lg border border-border text-sm text-text leading-relaxed font-sans">
            {typeof project.whyItMatters === 'object' ? project.whyItMatters[lang] : project.whyItMatters}
          </div>
        </div>
      </div>

      <!-- Architecture Tab -->
      <div id="tab-architecture" class="tab-content hidden space-y-6">
        <div>
          <h4 class="text-xs font-bold uppercase tracking-widest text-text-dim mb-2">
            {t('modal.diagramTag')}
          </h4>
          <Fragment set:html={renderArchitecturalDiagram(project.abstractDiagramType)} />
        </div>

        {project.aiRole && (
          <div>
            <h4 class="text-xs font-bold uppercase tracking-widest text-text-dim mb-2 flex items-center space-x-1.5">
              <Icon name="tabler:sparkles" class="w-3.5 h-3.5 text-accent" />
              <span>{t('modal.aiRoleTag')}</span>
            </h4>
            <div class="bg-accent-soft p-4 sm:p-5 rounded-lg border border-border text-sm text-text leading-relaxed font-sans">
              {typeof project.aiRole === 'object' ? project.aiRole[lang] : project.aiRole}
            </div>
          </div>
        )}

        {project.architectureNotes && (
          <div>
            <h4 class="text-xs font-bold uppercase tracking-widest text-text-dim mb-2">
              {t('modal.archNotesTag')}
            </h4>
            <div class="bg-surface-2 p-4 sm:p-5 rounded-lg border border-border text-xs font-mono text-text-dim leading-relaxed">
              {typeof project.architectureNotes === 'object' ? project.architectureNotes[lang] : project.architectureNotes}
            </div>
          </div>
        )}
      </div>

      <!-- Stack Tab -->
      <div id="tab-stack" class="tab-content hidden space-y-6">
        {project.metrics && (
          <div>
            <h4 class="text-xs font-bold uppercase tracking-widest text-text-dim mb-3">
              {t('modal.metricsTag')}
            </h4>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              {project.metrics.map((metric) => (
                <div class="bg-surface-2 border border-border p-4 sm:p-5 rounded-lg text-center flex sm:flex-col items-center justify-between sm:justify-center">
                  <span class="font-bold text-2xl sm:text-3xl text-accent sm:mb-1">
                    {metric.value}
                  </span>
                  <span class="text-xs font-mono text-text-dim text-right sm:text-center">
                    {typeof metric.label === 'object' ? metric.label[lang] : metric.label}
                  </span>
                </div>
              ))}
            </div>
          </div>
        )}

        <div>
          <h4 class="text-xs font-bold uppercase tracking-widest text-text-dim mb-3">
            {t('modal.stackTag')}
          </h4>
          <div class="flex flex-wrap gap-2">
            {project.stack.map((tech) => (
              <span class="text-xs font-mono px-2.5 py-1.5 bg-surface-2 text-text-dim border border-border rounded shadow-xs">
                {tech}
              </span>
            ))}
          </div>
        </div>

        {project.demoCredentials && (
          <div class="bg-surface-2 border border-border p-4 sm:p-5 rounded-lg">
            <span class="text-xs font-mono text-accent block mb-1 font-semibold">
              {t('modal.demoCredentialsTag')}
            </span>
            <p class="text-xs font-mono text-text-dim whitespace-pre-wrap">
              {typeof project.demoCredentials === 'object' ? project.demoCredentials[lang] : project.demoCredentials}
            </p>
          </div>
        )}
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  const setupTabs = () => {
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-target');

        // Reset buttons
        tabBtns.forEach(b => {
          b.classList.remove('border-accent', 'text-accent', 'font-semibold');
          b.classList.add('border-transparent', 'text-text-dim');
        });

        // Activate button
        btn.classList.remove('border-transparent', 'text-text-dim');
        btn.classList.add('border-accent', 'text-accent', 'font-semibold');

        // Hide all contents
        tabContents.forEach(content => {
          content.classList.add('hidden');
          content.classList.remove('block');
        });

        // Show target content
        const targetContent = document.getElementById(`tab-${target}`);
        if (targetContent) {
          targetContent.classList.remove('hidden');
          targetContent.classList.add('block');
        }
      });
    });
  };

  document.addEventListener('DOMContentLoaded', setupTabs);
  document.addEventListener('astro:page-load', setupTabs);
</script>

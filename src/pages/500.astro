---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

const lang = Astro.url.pathname.startsWith('/en') ? 'en' : 'it';

const copy = {
  it: {
    tag: 'Errore del server',
    title: 'Qualcosa è andato storto.',
    subtitle: 'Si è verificato un errore interno del server. Non è colpa tua — sto già investigando. Riprova tra qualche secondo o contattami direttamente.',
    ctaHome: 'Riprova dalla home',
    ctaContact: 'Segnalami il problema',
    breadcrumb: '/ errore-del-server',
    hint: 'Ogni sistema critico ha un piano B. Sto lavorando al piano B.',
    terminalLines: [
      '$ ./server --health-check',
      'ERROR: Internal server error (500)',
      'TRACE: Unexpected exception caught',
      '→ Notifying engineer on-call...',
      '$ systemctl restart portfolio.service',
      '✓ Recovery in progress...',
    ],
  },
  en: {
    tag: 'Server error',
    title: 'Something went wrong.',
    subtitle: "An internal server error occurred. It's not your fault — I'm already looking into it. Try again in a few seconds or contact me directly.",
    ctaHome: 'Try again from home',
    ctaContact: 'Report the issue',
    breadcrumb: '/ server-error',
    hint: 'Every critical system has a plan B. Working on plan B.',
    terminalLines: [
      '$ ./server --health-check',
      'ERROR: Internal server error (500)',
      'TRACE: Unexpected exception caught',
      '→ Notifying engineer on-call...',
      '$ systemctl restart portfolio.service',
      '✓ Recovery in progress...',
    ],
  },
};

const t = copy[lang] ?? copy['it'];
const homeUrl = lang === 'en' ? '/en/' : '/';
const contactUrl = lang === 'en' ? '/en/#contact' : '/#contact';

Astro.response.status = 500;
---

<Layout
  title={`500 — ${t.tag} | Giorgio Di Cristofalo`}
  description={t.subtitle}
  lang={lang}
  robots="noindex, nofollow"
>
  <main class="min-h-screen bg-bg flex flex-col items-center justify-center px-6 py-24 relative overflow-hidden">

    <!-- Ambient background glows (warm/red tone for error) -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <div class="glow-orb glow-1"></div>
      <div class="glow-orb glow-2"></div>
      <div class="grid-overlay"></div>
    </div>

    <!-- Main content -->
    <div class="card-500 relative z-10 w-full max-w-2xl">

      <!-- Top breadcrumb bar -->
      <div class="flex items-center space-x-2 mb-8">
        <a href={homeUrl} class="flex items-center space-x-1.5 text-xs font-mono text-text-dim hover:text-accent transition-colors group">
          <span class="w-5 h-5 rounded bg-surface-2 border border-border flex items-center justify-center group-hover:border-accent transition-colors">
            <Icon name="tabler:home" class="w-3 h-3" />
          </span>
          <span>giorgiodicristofalo.it</span>
        </a>
        <span class="font-mono text-xs text-border">/</span>
        <span class="font-mono text-xs" style="color:#f87171">{t.breadcrumb}</span>
      </div>

      <!-- Status badge -->
      <div class="inline-flex items-center space-x-2 px-3 py-1.5 rounded-full border mb-6"
        style="border-color:rgba(248,113,113,0.25);background:rgba(248,113,113,0.05);">
        <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background:#f87171;"></span>
        <span class="text-xs font-mono" style="color:#f87171;">HTTP 500 · {t.tag}</span>
      </div>

      <!-- Big 500 -->
      <div class="relative mb-2">
        <span class="code-500 select-none" aria-hidden="true">500</span>
      </div>

      <!-- Title + subtitle -->
      <h1 class="font-heading font-bold text-2xl sm:text-3xl text-text tracking-tight mb-4 leading-snug">
        {t.title}
      </h1>
      <p class="text-text-dim text-sm sm:text-base leading-relaxed mb-8 max-w-lg">
        {t.subtitle}
      </p>

      <!-- Terminal block -->
      <div class="terminal-block mb-8">
        <div class="terminal-header">
          <span class="dot" style="background:#f87171;"></span>
          <span class="dot" style="background:#facc15;"></span>
          <span class="dot" style="background:#4ade80;"></span>
          <span class="ml-2 text-xs font-mono text-white opacity-30">zsh · ~ [CRITICAL]</span>
        </div>
        <div class="terminal-body" id="terminal-output-500">
        </div>
      </div>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-3">
        <a
          href={homeUrl}
          id="cta-home-500"
          class="inline-flex items-center space-x-2 px-5 py-2.5 rounded-sm font-bold text-sm transition-all shadow-md hover:shadow-lg hover:-translate-y-px"
          style="background:#f87171;color:#fff;"
        >
          <Icon name="tabler:refresh" class="w-4 h-4" />
          <span>{t.ctaHome}</span>
        </a>
        <a
          href={contactUrl}
          id="cta-contact-500"
          class="inline-flex items-center space-x-2 px-5 py-2.5 rounded-sm border border-border bg-surface text-text font-semibold text-sm hover:border-accent hover:text-accent transition-all"
        >
          <Icon name="tabler:bug" class="w-4 h-4" />
          <span>{t.ctaContact}</span>
        </a>
      </div>

      <p class="mt-8 text-xs font-mono text-text-dim opacity-40">{t.hint}</p>
    </div>
  </main>
</Layout>

<script define:vars={{ terminalLines: t.terminalLines }}>
  (function() {
  const output = document.getElementById('terminal-output-500');
  if (!output) return;

  const lineTypes = ['cmd', 'err', 'err', 'warn', 'cmd', 'ok'];
  const colors = {
    cmd:  '#5B7FA0',
    err:  '#f87171',
    warn: '#facc15',
    ok:   '#4ade80',
  };

  let lineIndex = 0;
  let charIndex = 0;
  let currentEl = null;

  function nextLine() {
    if (lineIndex >= terminalLines.length) return;
    const type = lineTypes[lineIndex] || 'cmd';
    const color = colors[type];

    currentEl = document.createElement('div');
    currentEl.style.cssText = `display:flex;align-items:flex-start;gap:4px;min-height:18px;font-family:monospace;font-size:12px;line-height:1.6;color:${color};`;

    if (type === 'cmd') {
      const prompt = document.createElement('span');
      prompt.textContent = '❯ ';
      prompt.style.color = 'rgba(91,127,160,0.5)';
      currentEl.appendChild(prompt);
    }

    output.appendChild(currentEl);
    charIndex = 0;
    typeChar(terminalLines[lineIndex]);
  }

  function typeChar(text) {
    if (charIndex < text.length) {
      const span = document.createElement('span');
      span.textContent = text[charIndex];
      currentEl.appendChild(span);
      charIndex++;
      setTimeout(() => typeChar(text), Math.random() * 28 + 12);
    } else {
      lineIndex++;
      const pause = lineIndex === 3 ? 600 : 220;
      setTimeout(nextLine, pause);
    }
  }

  setTimeout(nextLine, 700);
  })();
</script>

<style>
  .glow-orb {
    position: absolute;
    border-radius: 9999px;
    filter: blur(90px);
    pointer-events: none;
  }
  .glow-1 {
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, rgba(248,113,113,0.18) 0%, transparent 70%);
    top: -140px;
    left: -120px;
    animation: float1 9s ease-in-out infinite;
  }
  .glow-2 {
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, rgba(91,127,160,0.10) 0%, transparent 70%);
    bottom: -100px;
    right: -80px;
    animation: float2 11s ease-in-out infinite;
  }
  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(248,113,113,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(248,113,113,0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 20%, transparent 100%);
  }
  @keyframes float1 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(28px, 18px); }
  }
  @keyframes float2 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-18px, -26px); }
  }

  .card-500 {
    animation: fadeUp 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(22px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .code-500 {
    display: block;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: clamp(5.5rem, 18vw, 9.5rem);
    line-height: 1;
    letter-spacing: -0.05em;
    background: linear-gradient(125deg, #E2E0DA 0%, #f87171 50%, #DDDBD5 100%);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(0 0 48px rgba(248,113,113,0.20));
    margin-left: -3px;
    animation: shimmer 5s ease-in-out infinite;
  }
  @keyframes shimmer {
    0%, 100% { background-position: 0% 50%; }
    50%       { background-position: 100% 50%; }
  }

  .terminal-block {
    background: #18191C;
    border: 1px solid rgba(248,113,113,0.12);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 8px 36px rgba(0,0,0,0.20), 0 0 0 1px rgba(248,113,113,0.05);
  }
  .terminal-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: rgba(255,255,255,0.03);
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 9999px;
    display: inline-block;
    opacity: 0.75;
  }
  .terminal-body {
    padding: 14px 16px;
    min-height: 128px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
</style>

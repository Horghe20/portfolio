---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

const lang = (Astro.preferredLocale ?? 'it') as 'it' | 'en';

const copy = {
  it: {
    tag: 'Pagina non trovata',
    title: 'Questo percorso non esiste.',
    subtitle: 'Il link potrebbe essere rotto, la pagina rimossa, o hai digitato un URL errato. Nessun problema — ti riporto dove serve.',
    ctaHome: 'Torna alla home',
    ctaContact: 'Contattami',
    breadcrumb: '/ pagina-non-trovata',
    hint: 'Non è un bug. È un feature mancante.',
    terminalLines: [
      '$ cd /this-page',
      'bash: /this-page: No such file or directory',
      '$ ls /',
      'home/  en/  projects/  vcard  ...',
      '$ cd home/',
      '→ Reindirizzamento in corso...',
    ],
  },
  en: {
    tag: 'Page not found',
    title: "This route doesn't exist.",
    subtitle: "The link may be broken, the page removed, or you typed the wrong URL. No worries — I'll get you back on track.",
    ctaHome: 'Back to home',
    ctaContact: 'Contact me',
    breadcrumb: '/ page-not-found',
    hint: 'Not a bug. Just a missing feature.',
    terminalLines: [
      '$ cd /this-page',
      'bash: /this-page: No such file or directory',
      '$ ls /',
      'home/  en/  projects/  vcard  ...',
      '$ cd home/',
      '→ Redirecting...',
    ],
  },
};

const t = copy[lang] ?? copy['it'];
const homeUrl = lang === 'en' ? '/en/' : '/';
const contactUrl = lang === 'en' ? '/en/#contact' : '/#contact';

Astro.response.status = 404;
---

<Layout
  title={`404 — ${t.tag} | Giorgio Di Cristofalo`}
  description={t.subtitle}
  lang={lang}
  robots="noindex, nofollow"
>
  <main class="min-h-screen bg-bg flex flex-col items-center justify-center px-6 py-24 relative overflow-hidden">

    <!-- Ambient background glows -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <div class="glow-orb glow-1"></div>
      <div class="glow-orb glow-2"></div>
      <div class="grid-overlay"></div>
    </div>

    <!-- Main content -->
    <div class="card-404 relative z-10 w-full max-w-2xl">

      <!-- Top breadcrumb bar -->
      <div class="flex items-center space-x-2 mb-8">
        <a href={homeUrl} class="flex items-center space-x-1.5 text-xs font-mono text-text-dim hover:text-accent transition-colors group">
          <span class="w-5 h-5 rounded bg-surface-2 border border-border flex items-center justify-center group-hover:border-accent transition-colors">
            <Icon name="tabler:home" class="w-3 h-3" />
          </span>
          <span>giorgiodicristofalo.it</span>
        </a>
        <span class="font-mono text-xs text-border">/</span>
        <span class="font-mono text-xs text-accent">{t.breadcrumb}</span>
      </div>

      <!-- Status badge -->
      <div class="inline-flex items-center space-x-2 px-3 py-1.5 rounded-full border border-border bg-surface text-xs font-mono text-text-dim mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-red-400 animate-pulse"></span>
        <span>HTTP 404 · {t.tag}</span>
      </div>

      <!-- Big 404 -->
      <div class="relative mb-2">
        <span class="code-404 select-none" aria-hidden="true">404</span>
      </div>

      <!-- Title + subtitle -->
      <h1 class="font-heading font-bold text-2xl sm:text-3xl text-text tracking-tight mb-4 leading-snug">
        {t.title}
      </h1>
      <p class="text-text-dim text-sm sm:text-base leading-relaxed mb-8 max-w-lg">
        {t.subtitle}
      </p>

      <!-- Terminal block -->
      <div class="terminal-block mb-8">
        <div class="terminal-header">
          <span class="dot bg-red-400"></span>
          <span class="dot bg-yellow-400"></span>
          <span class="dot bg-green-400"></span>
          <span class="ml-2 text-xs font-mono text-white opacity-30">zsh · ~</span>
        </div>
        <div class="terminal-body" id="terminal-output">
        </div>
      </div>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-3">
        <a
          href={homeUrl}
          id="cta-home-404"
          class="inline-flex items-center space-x-2 px-5 py-2.5 rounded-sm bg-accent text-accent-contrast font-bold text-sm hover:opacity-90 transition-all shadow-md shadow-accent/20 hover:shadow-lg hover:-translate-y-px"
        >
          <Icon name="tabler:arrow-left" class="w-4 h-4" />
          <span>{t.ctaHome}</span>
        </a>
        <a
          href={contactUrl}
          id="cta-contact-404"
          class="inline-flex items-center space-x-2 px-5 py-2.5 rounded-sm border border-border bg-surface text-text font-semibold text-sm hover:border-accent hover:text-accent transition-all"
        >
          <Icon name="tabler:mail" class="w-4 h-4" />
          <span>{t.ctaContact}</span>
        </a>
      </div>

      <p class="mt-8 text-xs font-mono text-text-dim opacity-40">{t.hint}</p>
    </div>
  </main>
</Layout>

<script define:vars={{ terminalLines: t.terminalLines }}>
  const output = document.getElementById('terminal-output');
  if (!output) return;

  const lineTypes = ['cmd', 'err', 'info', 'info', 'cmd', 'ok'];
  const colors = {
    cmd: '#5B7FA0',
    err: '#f87171',
    info: '#71727A',
    ok: '#4ade80',
  };

  let lineIndex = 0;
  let charIndex = 0;
  let currentEl = null;
  let charEls = [];

  function nextLine() {
    if (lineIndex >= terminalLines.length) return;
    const type = lineTypes[lineIndex] || 'info';
    const color = colors[type];

    currentEl = document.createElement('div');
    currentEl.style.cssText = `display:flex;align-items:flex-start;gap:4px;min-height:18px;font-family:monospace;font-size:12px;line-height:1.6;color:${color};`;

    if (type === 'cmd') {
      const prompt = document.createElement('span');
      prompt.textContent = '❯ ';
      prompt.style.color = 'rgba(91,127,160,0.5)';
      currentEl.appendChild(prompt);
    }

    output.appendChild(currentEl);
    charIndex = 0;
    charEls = [];
    typeChar(terminalLines[lineIndex]);
  }

  function typeChar(text) {
    if (charIndex < text.length) {
      const span = document.createElement('span');
      span.textContent = text[charIndex];
      currentEl.appendChild(span);
      charIndex++;
      const delay = Math.random() * 28 + 12;
      setTimeout(() => typeChar(text), delay);
    } else {
      lineIndex++;
      const pause = lineIndex === 2 ? 450 : 200;
      setTimeout(nextLine, pause);
    }
  }

  setTimeout(nextLine, 700);
</script>

<style>
  .glow-orb {
    position: absolute;
    border-radius: 9999px;
    filter: blur(90px);
    opacity: 0.10;
    pointer-events: none;
  }
  .glow-1 {
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, #5B7FA0 0%, transparent 70%);
    top: -140px;
    left: -120px;
    animation: float1 9s ease-in-out infinite;
  }
  .glow-2 {
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, #7BA7C7 0%, transparent 70%);
    bottom: -100px;
    right: -80px;
    animation: float2 11s ease-in-out infinite;
  }
  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(91,127,160,0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(91,127,160,0.035) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 20%, transparent 100%);
  }
  @keyframes float1 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(28px, 18px); }
  }
  @keyframes float2 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-18px, -26px); }
  }

  .card-404 {
    animation: fadeUp 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(22px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .code-404 {
    display: block;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: clamp(5.5rem, 18vw, 9.5rem);
    line-height: 1;
    letter-spacing: -0.05em;
    background: linear-gradient(125deg, #C8C5BC 0%, #5B7FA0 55%, #DDDBD5 100%);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(0 0 48px rgba(91,127,160,0.18));
    margin-left: -3px;
    animation: shimmer 5s ease-in-out infinite;
  }
  @keyframes shimmer {
    0%, 100% { background-position: 0% 50%; }
    50%       { background-position: 100% 50%; }
  }

  .terminal-block {
    background: #18191C;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 8px 36px rgba(0,0,0,0.20), 0 0 0 1px rgba(91,127,160,0.06);
  }
  .terminal-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: rgba(255,255,255,0.03);
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 9999px;
    display: inline-block;
    opacity: 0.75;
  }
  .terminal-body {
    padding: 14px 16px;
    min-height: 128px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
</style>

---
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getRelativeLocaleUrl } from '../../i18n/utils';

const lang = 'it';
const title = "Perché la ricerca operativa batte gli LLM: Google OR-Tools | Giorgio Di Cristofalo";
const description = "Analisi ingegneristica sull'ottimizzazione spaziale e vincoli rigidi: perché Google OR-Tools CP-SAT supera i Large Language Model con zero allucinazioni e garanzie deterministiche.";

const articleStructuredData = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "Perché la ricerca operativa batte i Large Language Model: ottimizzazione spaziale e vincoli rigidi con Google OR-Tools",
  "description": description,
  "author": {
    "@type": "Person",
    "@id": "https://giorgiodicristofalo.com/#person",
    "name": "Giorgio Di Cristofalo"
  },
  "datePublished": "2026-10-19",
  "dateModified": "2026-10-19",
  "image": "https://giorgiodicristofalo.com/images/projects/harbor-manager.webp",
  "inLanguage": "it",
  "keywords": "Google OR-Tools, CP-SAT Solver, Constraint Programming, Operations Research, Large Language Models, Software Architecture, 2D Bin Packing, Python"
};

const pythonCode = `from ortools.sat.python import cp_model

def solve_berth_allocation(boats, dock_length, dock_depth):
    model = cp_model.CpModel()
    x_intervals, y_intervals = [], []
    assigned_vars = {}

    for boat in boats:
        # Variabili di decisione per la posizione (x, y) sul molo
        x_start = model.NewIntVar(0, dock_length - boat["length"], f"x_start_{boat['id']}")
        x_end = model.NewIntVar(0, dock_length, f"x_end_{boat['id']}")
        x_int = model.NewIntervalVar(x_start, boat["length"] + boat["buffer_x"], x_end, f"x_int_{boat['id']}")

        y_start = model.NewIntVar(0, dock_depth - boat["width"], f"y_start_{boat['id']}")
        y_end = model.NewIntVar(0, dock_depth, f"y_end_{boat['id']}")
        y_int = model.NewIntervalVar(y_start, boat["width"] + boat["buffer_y"], y_end, f"y_int_{boat['id']}")

        is_assigned = model.NewBoolVar(f"assigned_{boat['id']}")
        assigned_vars[boat['id']] = is_assigned

        x_intervals.append(x_int)
        y_intervals.append(y_int)

    # Garanzia matematica: nessuna intersezione geometrica nel piano 2D
    model.AddNoOverlap2D(x_intervals, y_intervals)

    # Obiettivo: massimizzare il gettito economico e i posti occupati
    model.Maximize(sum(assigned_vars[b['id']] * b['revenue'] for b in boats))

    solver = cp_model.CpSolver()
    solver.parameters.max_time_in_seconds = 5.0
    status = solver.Solve(model)

    if status in (cp_model.OPTIMAL, cp_model.FEASIBLE):
        return {
            b['id']: (solver.Value(model.GetIntVar(f"x_start_{b['id']}")),
                      solver.Value(model.GetIntVar(f"y_start_{b['id']}")))
            for b in boats if solver.Value(assigned_vars[b['id']]) == 1
        }
    return None`;
---

<Layout 
  lang={lang} 
  title={title}
  description={description}
  image="/images/projects/harbor-manager.webp"
  structuredData={articleStructuredData}
>
  <Navbar />

  <main class="pt-24 pb-20 sm:pt-32 sm:pb-28 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto font-sans">
    
    <!-- Breadcrumbs / Back button -->
    <a href={getRelativeLocaleUrl(lang, '/#laboratory')} class="inline-flex items-center space-x-2 text-xs font-mono text-text-dim hover:text-accent transition-colors mb-8 group">
      <Icon name="tabler:arrow-left" class="w-4 h-4 group-hover:-translate-x-1 transition-transform" />
      <span>Torna al Laboratorio</span>
    </a>

    <!-- Article Header -->
    <header class="mb-12 pb-8 border-b border-border">
      <div class="flex items-center space-x-2.5 mb-4 flex-wrap gap-y-1">
        <span class="text-[10px] font-mono px-2.5 py-1 bg-accent-soft text-accent border border-border rounded font-semibold uppercase tracking-wider">
          Ingegneria dei Sistemi & Ricerca Operativa
        </span>
        <span class="text-xs font-mono text-text-dim">
          Ottobre 2026 • 6 min di lettura
        </span>
      </div>

      <h1 class="font-bold text-3xl sm:text-5xl text-text leading-tight mb-5 tracking-tight">
        Perché la ricerca operativa batte i Large Language Model: ottimizzazione spaziale e vincoli rigidi con Google OR-Tools
      </h1>

      <p class="text-base sm:text-lg text-text-dim leading-relaxed font-sans max-w-3xl">
        Nel contesto dell'allocazione spaziale e dei problemi NP-hard, i modelli generativi probabilistici falliscono sui vincoli fisici non negoziabili. Ecco perché i solver deterministici come Google OR-Tools CP-SAT rimangono lo standard d'eccellenza nell'ingegneria del software.
      </p>

      <div class="mt-6 flex items-center space-x-3 text-xs font-mono text-text-dim pt-4 border-t border-border/50">
        <span class="text-text font-medium">Autore: Giorgio Di Cristofalo</span>
        <span>•</span>
        <span>Software Engineer @ ENAV Group</span>
      </div>
    </header>

    <!-- Article Content -->
    <article class="space-y-10 text-text leading-relaxed text-base sm:text-lg">

      <!-- Intro callout -->
      <div class="bg-surface-2 border-l-4 border-accent p-5 sm:p-6 rounded-r-lg text-sm sm:text-base text-text leading-relaxed">
        <strong class="font-bold text-accent block mb-1">Il principio chiave:</strong>
        I Large Language Model eccellono nella sintesi, nella traduzione e nell'interfaccia utente. Quando il problema richiede però il rispetto matematico di vincoli fisici (pescaggio fondale, tolleranze millimetriche, zero sovrapposizioni), la probabilità statistica deve cedere il passo alla correttezza deterministica.
      </div>

      <!-- Section 1 -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-text">
          1. L'illusione dell'intuizione spaziale negli LLM
        </h2>
        <p class="text-text-dim text-sm sm:text-base leading-relaxed">
          I modelli di linguaggio basati su transformer generano token sequenziali attraverso stime di probabilità condizionate apprese durante il pre-training. Non hanno accesso a una griglia euclidea interna né a un motore di propagazione geometrica.
        </p>
        <p class="text-text-dim text-sm sm:text-base leading-relaxed">
          Affidare a un prompt l'allocazione di decine di imbarcazioni di lunghezza, larghezza e pescaggio eterogenei (il problema reale del progetto <a href={getRelativeLocaleUrl(lang, '/projects/harbor-manager')} class="text-accent underline font-mono">Harbor Manager</a>) espone il sistema a tre criticità insostenibili in produzione:
        </p>
        <ul class="space-y-2.5 text-sm sm:text-base text-text-dim list-disc pl-5">
          <li>
            <strong class="text-text">Mancanza di garanzie sui vincoli rigidi (hard constraints)</strong>: un LLM può produrre coordinate plausibili in JSON, ma non può garantire che due scafi non si tocchino per 10 centimetri o che il fondale sia sufficiente durante la bassa marea. In mare, una violazione su cento significa un incidente nautico o un danno economico.
          </li>
          <li>
            <strong class="text-text">Allucinazione combinatoria</strong>: man mano che il numero di barche o colli cresce, la complessità combinatoria esplode. I modelli dimenticano vincoli negativi o inventano coordinate di banchina fisicamente inesistenti.
          </li>
          <li>
            <strong class="text-text">Costo computazionale e non-determinismo</strong>: ogni inferenza LLM complessa richiede secondi preziosi, consuma budget API e fornisce output diversi a ogni esecuzione. Un solver matematico converge all'ottimo globale (o certifica l'inammissibilità) in frazioni di secondo a costo zero.
          </li>
        </ul>
      </section>

      <!-- Section 2 -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-text">
          2. La formulazione formale: Constraint Programming & SAT
        </h2>
        <p class="text-text-dim text-sm sm:text-base leading-relaxed">
          La <em>Constraint Programming</em> (programmazione a vincoli) inverte l'approccio: invece di indovinare una configurazione per tentativi statistici, definisce lo spazio degli stati ammissibili tramite variabili di decisione e vincoli algebrici. Il motore di ricerca esplora l'albero delle soluzioni potando intere combinazioni non ammissibili grazie alla propagazione logica.
        </p>
        
        <div class="bg-surface border border-border p-5 rounded-lg font-mono text-xs sm:text-sm text-text-dim space-y-2">
          <div class="text-accent font-semibold">// Modello 2D Bin Packing a vincoli disgiunti</div>
          <div>• Coordinate spaziali: x_i (posizione su banchina), y_i (distanza dal canale)</div>
          <div>• Finestre temporali: [t_start, t_end]</div>
          <div>• Dimensioni fisiche: Lunghezza (L_i), Baglio (B_i) + Buffer di rispetto</div>
          <div>• Vincolo batimetrico: Pescaggio_i ≤ Fondale(x_i, y_i) ∀ i</div>
          <div>• Vincolo di non-sovrapposizione: Overlap(Barca_i, Barca_j) = 0 ∀ i ≠ j</div>
        </div>
      </section>

      <!-- Section 3 -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-text">
          3. Implementazione con Google OR-Tools (CP-SAT)
        </h2>
        <p class="text-text-dim text-sm sm:text-base leading-relaxed">
          Google OR-Tools include <strong>CP-SAT</strong>, uno dei più performanti solver moderni al mondo. In Python, il vincolo critico di non-sovrapposizione bidimensionale viene risolto elegantemente con la funzione nativa <code class="font-mono text-accent">AddNoOverlap2D</code>:
        </p>

        <!-- Code Block -->
        <div class="bg-surface-2 border border-border rounded-lg overflow-hidden text-xs font-mono shadow-xs">
          <div class="bg-surface border-b border-border px-4 py-2 flex items-center justify-between text-text-dim text-[11px]">
            <span>berth_allocation_solver.py</span>
            <span class="text-accent font-semibold">Python 3.12 + OR-Tools CP-SAT</span>
          </div>
          <pre class="p-4 sm:p-5 overflow-x-auto text-text leading-relaxed font-mono text-xs"><code>{pythonCode}</code></pre>
        </div>
      </section>

      <!-- Section 4 -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-text">
          4. Risultati concreti: il caso Harbor Manager
        </h2>
        <p class="text-text-dim text-sm sm:text-base leading-relaxed">
          Nel progetto di gestione portuale sviluppato da Giorgio, l'integrazione di Google OR-Tools in una pipeline asincrona con worker Celery ha prodotto risultati misurabili:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
          <div class="bg-surface border border-border p-4 rounded-lg text-center">
            <span class="font-bold text-3xl text-accent block mb-1">+22%</span>
            <span class="text-xs font-mono text-text-dim">Spazio recuperato rispetto alla gestione manuale</span>
          </div>
          <div class="bg-surface border border-border p-4 rounded-lg text-center">
            <span class="font-bold text-3xl text-accent block mb-1">&lt; 2.4s</span>
            <span class="text-xs font-mono text-text-dim">Tempo di calcolo su banchina intera</span>
          </div>
          <div class="bg-surface border border-border p-4 rounded-lg text-center">
            <span class="font-bold text-3xl text-accent block mb-1">0%</span>
            <span class="text-xs font-mono text-text-dim">Allucinazioni e violazioni sui vincoli di sicurezza</span>
          </div>
        </div>
      </section>

      <!-- Section 5: Comparison Table -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-text">
          5. Il ruolo corretto dell'AI nei sistemi di produzione
        </h2>
        <p class="text-text-dim text-sm sm:text-base leading-relaxed">
          La vera maturità ingegneristica non consiste nell'usare l'AI ovunque, ma nel sapere <strong>quale componente architetturale assegnare a ciascun problema</strong>:
        </p>

        <div class="overflow-x-auto border border-border rounded-lg bg-surface">
          <table class="w-full text-left text-xs sm:text-sm font-sans">
            <thead class="bg-surface-2 border-b border-border font-mono text-[11px] uppercase tracking-wider text-text-dim">
              <tr>
                <th class="p-3.5">Funzione del sistema</th>
                <th class="p-3.5">Tecnologia adatta</th>
                <th class="p-3.5">Motivazione ingegneristica</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border text-text">
              <tr>
                <td class="p-3.5 font-medium">Comprensione linguaggio naturale</td>
                <td class="p-3.5 font-mono text-accent">LLM (Gemini / Claude / GPT)</td>
                <td class="p-3.5 text-text-dim">Estrazione parametri da email, messaggi e richieste vocali non strutturate.</td>
              </tr>
              <tr>
                <td class="p-3.5 font-medium">Ottimizzazione vincolata e fisica</td>
                <td class="p-3.5 font-mono text-accent">Google OR-Tools (CP-SAT)</td>
                <td class="p-3.5 text-text-dim">Zero allucinazioni, rispetto algebrico di distanze, tempi e capienze.</td>
              </tr>
              <tr>
                <td class="p-3.5 font-medium">Raccomandazioni rapide in-database</td>
                <td class="p-3.5 font-mono text-accent">kNN Vettoriale in SQL (Postgres)</td>
                <td class="p-3.5 text-text-dim">Latenze &lt;30ms senza overhead di rete o costi API per query.</td>
              </tr>
              <tr>
                <td class="p-3.5 font-medium">Consegna streaming al client</td>
                <td class="p-3.5 font-mono text-accent">Celery + Redis Pub/Sub + SSE</td>
                <td class="p-3.5 text-text-dim">Disaccoppiamento totale tra computazione asincrona e thread HTTP web.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Conclusion & CTA Box -->
      <section class="pt-8 border-t border-border space-y-6">
        <h2 class="text-2xl font-bold tracking-tight text-text">
          Conclusioni
        </h2>
        <p class="text-text-dim text-sm sm:text-base leading-relaxed">
          I modelli generativi sono una risorsa potente per interpretare l'ambiguità del linguaggio umano. Ma quando un errore di calcolo comporta costi materiali, inefficienze operative o rischi per la sicurezza, la matematica discreta e i solver di ricerca operativa rimangono insostituibili.
        </p>

        <!-- Project Leave-behind Card -->
        <div class="bg-surface-2 border border-border p-6 rounded-lg flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mt-8">
          <div>
            <span class="text-[11px] font-mono text-accent font-semibold uppercase tracking-wider block mb-1">
              Caso Studio Correlato
            </span>
            <h3 class="font-bold text-lg text-text">Harbor Manager — Ottimizzazione Portuale con OR-Tools</h3>
            <p class="text-xs text-text-dim mt-1 max-w-xl">
              Esplora l'architettura completa, i diagrammi del flusso dati PostGIS ➔ Celery ➔ Angular e le metriche di produzione.
            </p>
          </div>
          <div class="flex items-center space-x-3 shrink-0">
            <a 
              href={getRelativeLocaleUrl(lang, '/projects/harbor-manager')}
              class="px-4 py-2 bg-accent text-accent-contrast font-bold text-xs rounded-sm hover:opacity-90 transition-all shadow-xs"
            >
              Vedi Caso Studio
            </a>
            <a 
              href={getRelativeLocaleUrl(lang, '/#contact')}
              class="px-4 py-2 bg-surface text-text border border-border hover:border-accent font-semibold text-xs rounded-sm transition-all shadow-xs"
            >
              Contattami
            </a>
          </div>
        </div>
      </section>

    </article>
  </main>

  <Footer />
</Layout>

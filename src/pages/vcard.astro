---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { PERSONAL_INFO } from '../data/content';
import logoImage from '../assets/logo.png';
import cardBg from '../assets/card-background.jpg';

// HTTP header protection against scrapers & indexing
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive, nosnippet, noimageindex');
---

<Layout 
  title={`${PERSONAL_INFO.name} - Digital Card`} 
  robots="noindex, nofollow, noarchive, nosnippet, noimageindex"
  manifest="/vcard.webmanifest"
  appleTitle="Giorgio Card"
  themeColor="#f2f2f7"
>
  <!-- Sfondo stile Apple Wallet (grigio chiaro) -->
  <main class="min-h-[100dvh] bg-[#f2f2f7] flex flex-col items-center justify-center p-4 sm:p-8 font-sans" style="background-color: #f2f2f7;">

    <!-- Container Carta di Credito -->
    <!-- Utilizziamo stili inline per le dimensioni e i bordi smussati per evitare problemi con la configurazione Tailwind -->
    <div 
      class="relative overflow-hidden shadow-2xl flex flex-col justify-between p-6 sm:p-7 border border-black/10 isolate" 
      style="width: 100%; max-width: 380px; aspect-ratio: 1.586/1; border-radius: 24px; color: #ffffff; mask-image: radial-gradient(white, black); -webkit-mask-image: -webkit-radial-gradient(white, black);"
    >
      
      <!-- Immagine di sfondo caricata (ottimizzata automaticamente in WebP) -->
      <Image 
        src={cardBg} 
        alt="Card Background" 
        class="absolute inset-0 w-full h-full object-cover z-0 animate-ken-burns"
        width={800}
      />
      <!-- Overlay scuro per garantire un alto contrasto con il testo bianco -->
      <div class="absolute inset-0 bg-black/60 z-0"></div>
      
      <!-- Onde di luce (riflesso) -->
      <div class="absolute inset-0 z-0 skew-x-12 translate-x-10 pointer-events-none opacity-40" style="background: linear-gradient(to top right, transparent, rgba(255,255,255,0.1), transparent);"></div>

      <!-- Header Carta -->
      <div class="relative z-10 flex justify-between items-start">
        <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight leading-none drop-shadow-lg" style="color: #ffffff;">
          Giorgio<br/>Di Cristofalo
        </h1>
        <p class="text-[10px] sm:text-xs font-bold uppercase tracking-widest opacity-90 mt-1.5 drop-shadow-md text-right max-w-[100px]" style="color: #ffffff; line-height: 1.2;">Software<br/>Engineer</p>
      </div>

      <!-- Footer Carta -->
      <div class="relative z-10 flex flex-col">
        <div class="flex justify-between items-end">
          <div class="flex flex-col gap-1.5">
            <a href="tel:+393317234406" class="text-1xl tracking-[0.1em] drop-shadow-lg transition-colors hover:text-white/80" style="color: #ffffff; text-decoration: none;">
              +39 331 723 4406
            </a>
            <a href={`mailto:${PERSONAL_INFO.email}`} class="text-[13px] sm:text-sm font-semibold tracking-wider opacity-90 drop-shadow-md hover:opacity-100 transition-opacity" style="color: #ffffff; text-decoration: none;">
              giorgiodicristofalo77@gmail.com
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Azioni Rapide sotto la carta -->
    <div class="mt-8 flex flex-col items-center gap-5">
      
      <!-- Sito Web (Da solo in alto al centro) -->
      <a href="/" target="_blank" rel="noopener noreferrer" class="flex flex-col items-center gap-2 group">
        <div class="w-16 h-16 rounded-full shadow-md flex items-center justify-center overflow-hidden border transition-colors duration-300" style="background-color: #ffffff; border-color: #e2e0da;">
          <Image 
            src={logoImage} 
            alt="Website" 
            class="w-full h-full object-cover"
            width={64}
            height={64}
          />
        </div>
        <span class="text-xs font-medium" style="color: #8e8e93;">Sito</span>
      </a>

      <!-- LinkedIn, GitHub, Salva (Poco più sotto) -->
      <div class="flex gap-6 mt-1">
        <!-- LinkedIn -->
        <a href={PERSONAL_INFO.linkedin} target="_blank" rel="noopener noreferrer" class="flex flex-col items-center gap-2 group">
          <div class="w-14 h-14 rounded-full shadow-sm flex items-center justify-center transition-colors duration-300" style="background-color: #ffffff; color: #2c2c2e;">
            <Icon name="tabler:brand-linkedin" class="w-7 h-7" />
          </div>
          <span class="text-xs font-medium" style="color: #8e8e93;">LinkedIn</span>
        </a>

        <!-- GitHub -->
        <a href={PERSONAL_INFO.github} target="_blank" rel="noopener noreferrer" class="flex flex-col items-center gap-2 group">
          <div class="w-14 h-14 rounded-full shadow-sm flex items-center justify-center transition-colors duration-300" style="background-color: #ffffff; color: #2c2c2e;">
            <Icon name="tabler:brand-github" class="w-7 h-7" />
          </div>
          <span class="text-xs font-medium" style="color: #8e8e93;">GitHub</span>
        </a>
        
        <!-- Salva in Rubrica -->
        <a href="/giorgio.vcf" class="flex flex-col items-center gap-2 group">
          <div class="w-14 h-14 rounded-full shadow-sm flex items-center justify-center transition-colors duration-300" style="background-color: #ffffff; color: #2c2c2e;">
            <Icon name="tabler:address-book" class="w-7 h-7" />
          </div>
          <span class="text-xs font-medium" style="color: #8e8e93;">Salva</span>
        </a>
      </div>

      <!-- Guida Aggiungi a Schermata Home per Safari / Mobile -->
      <button 
        id="install-guide-btn" 
        type="button" 
        class="mt-3 inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-medium text-stone-600 bg-white/80 hover:bg-white border border-stone-200/70 shadow-xs transition-all cursor-pointer active:scale-95"
      >
        <Icon name="tabler:square-rounded-plus" class="w-4 h-4 text-stone-500" />
        <span id="install-guide-label">Aggiungi a schermata Home</span>
      </button>
      
    </div>

    <!-- Modal Istruzioni Aggiungi a Schermata Home (Safari / iOS) -->
    <div id="install-modal" class="fixed inset-0 z-50 bg-black/40 backdrop-blur-xs flex items-end sm:items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-200">
      <div class="bg-white w-full max-w-sm rounded-3xl p-6 shadow-2xl border border-stone-200 flex flex-col gap-4 transform translate-y-4 transition-transform duration-200" id="install-modal-box">
        <div class="flex items-start justify-between">
          <div class="flex items-center gap-2.5">
            <div class="w-9 h-9 rounded-xl bg-stone-100 flex items-center justify-center text-stone-800">
              <Icon name="tabler:device-mobile" class="w-5 h-5" />
            </div>
            <div>
              <h3 class="text-sm font-semibold text-stone-900 leading-tight">Salva Card su iPhone / Safari</h3>
              <p class="text-[11px] text-stone-500">Accesso rapido a tutto schermo</p>
            </div>
          </div>
          <button id="close-modal-btn" type="button" class="p-1 rounded-full text-stone-400 hover:text-stone-700 hover:bg-stone-100 transition-colors cursor-pointer">
            <Icon name="tabler:x" class="w-5 h-5" />
          </button>
        </div>

        <ol class="flex flex-col gap-3 text-xs text-stone-700 bg-stone-50 p-4 rounded-2xl border border-stone-100">
          <li class="flex items-start gap-2.5">
            <span class="flex-shrink-0 w-5 h-5 rounded-full bg-stone-200 text-stone-800 font-bold text-[10px] flex items-center justify-center">1</span>
            <span>Tocca il tasto <strong>Condividi</strong> in Safari <span class="text-stone-400 font-mono">(l'icona quadrata con la freccia in alto ⎋)</span>.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="flex-shrink-0 w-5 h-5 rounded-full bg-stone-200 text-stone-800 font-bold text-[10px] flex items-center justify-center">2</span>
            <span>Scorri il menu e seleziona <strong>"Aggiungi alla schermata Home"</strong>.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="flex-shrink-0 w-5 h-5 rounded-full bg-stone-200 text-stone-800 font-bold text-[10px] flex items-center justify-center">3</span>
            <span>Premi <strong>"Aggiungi"</strong> in alto a destra.</span>
          </li>
        </ol>

        <p class="text-[11px] text-amber-800 bg-amber-50 p-2.5 rounded-xl border border-amber-200/60 leading-relaxed">
          💡 <strong>Nota:</strong> Se sei in <em>"Navigazione privata"</em>, Safari disabilita l'aggiunta alla Home. Apri la pagina in una normale scheda Safari.
        </p>

        <button id="got-it-btn" type="button" class="w-full py-2.5 rounded-xl bg-stone-900 hover:bg-stone-800 text-white text-xs font-semibold tracking-wide transition-colors cursor-pointer">
          Ho capito
        </button>
      </div>
    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Nascondi il tasto se l'app è già aperta a tutto schermo da Home Screen (standalone)
      const isStandalone = window.matchMedia('(display-mode: standalone)').matches || (window.navigator as any).standalone;
      const guideBtn = document.getElementById('install-guide-btn');
      const modal = document.getElementById('install-modal');
      const modalBox = document.getElementById('install-modal-box');
      const closeBtn = document.getElementById('close-modal-btn');
      const gotItBtn = document.getElementById('got-it-btn');

      if (isStandalone && guideBtn) {
        guideBtn.style.display = 'none';
      }

      function openModal() {
        if (!modal || !modalBox) return;
        modal.classList.remove('opacity-0', 'pointer-events-none');
        modalBox.classList.remove('translate-y-4');
      }

      function closeModal() {
        if (!modal || !modalBox) return;
        modal.classList.add('opacity-0', 'pointer-events-none');
        modalBox.classList.add('translate-y-4');
      }

      guideBtn?.addEventListener('click', openModal);
      closeBtn?.addEventListener('click', closeModal);
      gotItBtn?.addEventListener('click', closeModal);
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    });
  </script>
</Layout>

<style>
  @keyframes ken-burns {
    0% { transform: scale(1) translate(0, 0); }
    50% { transform: scale(1.08) translate(-2%, -1%); }
    100% { transform: scale(1) translate(0, 0); }
  }
  .animate-ken-burns {
    animation: ken-burns 12s ease-in-out infinite;
    transform-origin: center center;
  }
</style>

---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from "@vercel/speed-insights/astro";
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'it' | 'en';
  robots?: string;
  image?: string;
  structuredData?: Record<string, any>;
}

const { 
  title = "Giorgio Di Cristofalo — Software Engineer",
  description = "Sito personale di Giorgio Di Cristofalo: Software Engineer specializzato in architetture distribuite, automazione processi e AI applicata (Google OR-Tools, NLP, Recommender Systems).",
  lang = 'it',
  robots = "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1",
  image = '/og-image.jpg',
  structuredData
} = Astro.props;

// Normalize pathname to prevent trailing slash issues (except for root '/')
const normalizedPathname = Astro.url.pathname.endsWith('/') && Astro.url.pathname.length > 1 
  ? Astro.url.pathname.slice(0, -1) 
  : Astro.url.pathname;

const baseUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://giorgiodicristofalo.com';

const alternateLang = lang === 'it' ? 'en' : 'it';
const alternateUrl = lang === 'it' 
  ? `${baseUrl}/en${normalizedPathname === '/' ? '' : normalizedPathname}` 
  : `${baseUrl}${normalizedPathname.replace(/^\/en/, '') || '/'}`;

const currentUrl = `${baseUrl}${normalizedPathname}`;
const ogImageUrl = image.startsWith('http') ? image : new URL(image, baseUrl).href;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Favicon (Ottimizzato per Google e Bing) -->
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="shortcut icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="/favicon.png" />
    
    <!-- Auto-Redirect based on browser language -->
    <script is:inline>
      (function() {
        try {
          var currentPath = window.location.pathname;
          // Pagine che NON hanno una versione /en (non soggette a redirect)
          var excludedPaths = ['/vcard', '/giorgio.vcf'];
          var isExcluded = excludedPaths.some(function(p) { return currentPath.startsWith(p); });
          
          if (!isExcluded) {
            var userPref = localStorage.getItem('lang-pref');
            if (!userPref) {
              var browserLang = navigator.language || navigator.userLanguage || '';
              var isItalian = browserLang.toLowerCase().startsWith('it');
              if (!isItalian && !currentPath.startsWith('/en')) {
                window.location.replace('/en' + (currentPath === '/' ? '' : currentPath) + window.location.hash);
              }
            }
          }
        } catch (e) {}
      })();
    </script>

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="Giorgio Di Cristofalo, Software Engineer, Software Engineer Palermo, Automazione Processi, CI/CD, ENAV Group, Faidda Tech Lab, Google OR-Tools, AI Applicata, Ingegneria Informatica UniPa, Python, Angular, TypeScript" />
    <meta name="author" content="Giorgio Di Cristofalo" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={currentUrl} />
    <link rel="alternate" hreflang={alternateLang} href={alternateUrl} />
    <link rel="alternate" hreflang={lang} href={currentUrl} />
    <link rel="alternate" hreflang="x-default" href={lang === 'it' ? currentUrl : alternateUrl} />

    <!-- GEO / Geographic Metadata (Palermo, Sicilia, Italy) -->
    <meta name="geo.region" content="IT-82" />
    <meta name="geo.placename" content="Palermo" />
    <meta name="geo.position" content="38.1157;13.3615" />
    <meta name="ICBM" content="38.1157, 13.3615" />
    <meta name="coverage" content="Worldwide / Italy / Sicily" />
    <meta name="target" content="all" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:site_name" content="Giorgio Di Cristofalo — Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'it' ? 'en_US' : 'it_IT'} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={currentUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Theme & Color Settings -->
    <meta name="theme-color" content="#F7F6F3" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    
    <!-- JSON-LD Structured Data for Search Engines, Perplexity, Gemini, ChatGPT (AEO / GEO / Schema.org) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": `${baseUrl}/#person`,
          "name": "Giorgio Di Cristofalo",
          "givenName": "Giorgio",
          "familyName": "Di Cristofalo",
          "jobTitle": "Software Engineer",
          "url": `${baseUrl}/`,
          "email": "giorgiodicristofalo77@gmail.com",
          "knowsAbout": [
            "Software Engineering",
            "Distributed Systems",
            "Process Automation",
            "Applied Artificial Intelligence",
            "Google OR-Tools",
            "Constraint Satisfaction Problems",
            "Celery",
            "Redis",
            "Python",
            "Django",
            "Flask",
            "PostgreSQL",
            "Adversarial Machine Learning",
            "CI/CD Pipelines",
            "Astro",
            "TypeScript"
          ],
          "worksFor": {
            "@type": "Organization",
            "name": "ENAV Group",
            "url": "https://www.enav.it"
          },
          "alumniOf": {
            "@type": "EducationalOrganization",
            "name": "Università degli Studi di Palermo",
            "url": "https://www.unipa.it"
          },
          "memberOf": {
            "@type": "Organization",
            "name": "Faidda Tech Lab",
            "url": "https://faiddatechlab.com/"
          },
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Palermo",
            "addressRegion": "Sicilia",
            "addressCountry": "IT"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": "38.1157",
            "longitude": "13.3615"
          },
          "sameAs": [
            "https://github.com/Horghe20",
            "https://www.linkedin.com/in/giorgiodicristofalo/",
            "https://faiddatechlab.com/"
          ]
        },
        {
          "@type": "WebSite",
          "@id": `${baseUrl}/#website`,
          "url": `${baseUrl}/`,
          "name": "Giorgio Di Cristofalo — Portfolio",
          "publisher": {
            "@id": `${baseUrl}/#person`
          },
          "inLanguage": ["it-IT", "en-US"]
        },
        {
          "@type": "ProfessionalService",
          "@id": `${baseUrl}/#service`,
          "name": "Giorgio Di Cristofalo — Software Engineering & Consulting",
          "url": `${baseUrl}/`,
          "provider": {
            "@id": `${baseUrl}/#person`
          },
          "areaServed": "Worldwide",
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "Engineering & Development Services",
            "itemListElement": [
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "Sviluppo Piattaforme Web Custom & MVP",
                  "description": "Progettazione e implementazione end-to-end di piattaforme web e gestionali ad alte prestazioni: database, architettura asincrona, pagamenti e UI."
                }
              },
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "Automazione Flussi Operativi & AI Applicata",
                  "description": "Ingegnerizzazione di flussi di lavoro aziendali complessi, integrazione API/CRM e ottimizzazione con algoritmi matematici deterministici e modelli AI."
                }
              }
            ]
          }
        }
      ]
    })} />
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
    
    <!-- Vercel Web Analytics is injected below -->
  </head>
  <body class="bg-bg text-text selection:bg-accent-soft selection:text-accent antialiased overflow-x-hidden font-sans">
    <slot />
    <Analytics />
    <SpeedInsights />
  </body>
</html>

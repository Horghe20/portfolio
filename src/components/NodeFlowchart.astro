---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  highlightedAudience?: 'all' | 'azienda' | 'recruiter' | 'dev';
}

const { highlightedAudience = 'all' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const nodes = [
  {
    id: 0,
    x: 70,
    y: 90,
    label: lang === 'it' ? 'Ingest & Requisiti' : 'Ingest & Needs',
    sub: lang === 'it' ? 'Dati, vincoli, workflow' : 'Data, constraints, ops',
    tech: 'PostGIS / API',
    category: 'input'
  },
  {
    id: 1,
    x: 230,
    y: 50,
    label: lang === 'it' ? 'Motore AI & Solver' : 'AI & Solver Engine',
    sub: lang === 'it' ? 'OR-Tools / NLP / kNN' : 'OR-Tools / NLP / kNN',
    tech: 'CP-SAT / Gemini / Vector',
    category: 'ai'
  },
  {
    id: 2,
    x: 390,
    y: 130,
    label: lang === 'it' ? 'Pipeline CI/CD' : 'CI/CD Pipeline',
    sub: lang === 'it' ? 'Test automatici & Docker' : 'Automated tests & Docker',
    tech: 'GitHub Actions / Linux',
    category: 'delivery'
  },
  {
    id: 3,
    x: 550,
    y: 70,
    label: lang === 'it' ? 'Sistemi Critici' : 'Critical Delivery',
    sub: lang === 'it' ? 'Zero-downtime & Uptime' : 'Zero-downtime & Uptime',
    tech: 'ATM / Web in Prod',
    category: 'prod'
  }
];

const defaultMessage = lang === 'it' ? 'Dai vincoli di business al rilascio deterministico in produzione.' : 'From complex business constraints to deterministic production release.';
---

<div class="w-full max-w-2xl mx-auto my-4 p-4 rounded-xl bg-surface border border-border shadow-sm relative overflow-hidden backdrop-blur-sm group" id="flowchart-container" data-default-message={defaultMessage}>
  <div class="flex items-center justify-between mb-3 px-2">
    <div class="flex items-center space-x-2">
      <span class="inline-block w-2 h-2 rounded-full bg-accent animate-pulse"></span>
      <span class="text-xs font-mono text-text-dim uppercase tracking-wider">
        {t('hero.flowchart.tag')}
      </span>
    </div>
    <span class="text-[11px] font-mono text-accent bg-accent-soft px-2 py-0.5 rounded border border-border" id="flowchart-tech">
      {t('hero.flowchart.hint')}
    </span>
  </div>

  <div class="relative w-full h-[180px] sm:h-[190px]">
    <svg 
      viewBox="0 0 620 180" 
      class="w-full h-full overflow-visible"
    >
      <defs>
        <linearGradient id="accentLineGradient" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stopColor="#5B7FA0" stopOpacity="0.4" />
          <stop offset="50%" stopColor="#5B7FA0" stopOpacity="1" />
          <stop offset="100%" stopColor="#5B7FA0" stopOpacity="0.5" />
        </linearGradient>

        <filter id="accentGlow" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="2.5" result="blur" />
          <feComposite in="SourceGraphic" in2="blur" operator="over" />
        </filter>
      </defs>

      <!-- Background Connecting Path -->
      <path
        d="M 70 90 C 150 90, 150 50, 230 50 C 310 50, 310 130, 390 130 C 470 130, 470 70, 550 70"
        fill="none"
        stroke="#E2E0DA"
        stroke-width="3"
        stroke-dasharray="4 4"
      />

      <!-- Animated Main Line -->
      <path
        id="flowchart-animated-line"
        d="M 70 90 C 150 90, 150 50, 230 50 C 310 50, 310 130, 390 130 C 470 130, 470 70, 550 70"
        fill="none"
        stroke="url(#accentLineGradient)"
        stroke-width="2.5"
        stroke-dasharray="600"
        stroke-dashoffset="600"
        class="transition-all duration-1000 ease-out motion-reduce:stroke-dashoffset-0"
      />

      <!-- Traveling Signal Pulse -->
      <circle r="4" fill="#5B7FA0" filter="url(#accentGlow)" class="motion-reduce:hidden opacity-0" id="flowchart-pulse">
        <animateMotion
          path="M 70 90 C 150 90, 150 50, 230 50 C 310 50, 310 130, 390 130 C 470 130, 470 70, 550 70"
          dur="4s"
          repeatCount="indefinite"
        />
      </circle>

      <!-- Nodes -->
      {nodes.map((node) => (
        <g 
          class="flowchart-node cursor-pointer transition-transform duration-200"
          data-node-id={node.id}
          data-node-tech={node.tech}
          data-node-label={node.label}
          data-node-sub={node.sub}
        >
          <!-- Outer Ring Pulse -->
          <circle
            cx={node.x}
            cy={node.y}
            r="14"
            fill="#FFFFFF"
            stroke="#E2E0DA"
            stroke-width="2"
            class="fc-outer transition-all duration-200"
          />

          <!-- Inner Core -->
          <circle
            cx={node.x}
            cy={node.y}
            r="4"
            fill="#71727A"
            class="fc-inner transition-all duration-200"
          />

          <!-- Labels -->
          <text
            x={node.x}
            y={node.y > 100 ? node.y + 30 : node.y - 32}
            text-anchor="middle"
            class="fc-label text-[11px] font-sans font-medium transition-colors duration-200 fill-[#2A2B2E]"
          >
            {node.label}
          </text>

          <text
            x={node.x}
            y={node.y > 100 ? node.y + 44 : node.y - 20}
            text-anchor="middle"
            class="text-[9px] font-mono fill-[#71727A]"
          >
            {node.sub}
          </text>
        </g>
      ))}
    </svg>
  </div>

  <!-- Active node detail prompt -->
  <div class="mt-1 pt-2 border-t border-border flex items-center justify-between text-xs text-text-dim">
    <span class="truncate" id="flowchart-desc">
      {defaultMessage}
    </span>
    <span class="font-mono text-[10px] text-accent shrink-0 ml-2 font-medium">
      CI/CD & AI
    </span>
  </div>
</div>

<script>
  // Flowchart logic
  const setupFlowchart = () => {
    const container = document.getElementById('flowchart-container');
    if (!container) return;

    const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const line = document.getElementById('flowchart-animated-line');
    const pulse = document.getElementById('flowchart-pulse');
    const nodes = document.querySelectorAll('.flowchart-node');
    const techDisplay = document.getElementById('flowchart-tech');
    const descDisplay = document.getElementById('flowchart-desc');
    const defaultMessage = container.getAttribute('data-default-message') || '';
    const defaultTech = techDisplay ? techDisplay.innerText : '';

    if (!isReducedMotion && line && pulse) {
      setTimeout(() => {
        line.style.strokeDashoffset = '0';
        pulse.classList.remove('opacity-0');
      }, 150);
    }

    nodes.forEach(node => {
      const activate = () => {
        // Reset all
        nodes.forEach(n => {
          n.querySelector('.fc-outer')?.setAttribute('r', '14');
          n.querySelector('.fc-outer')?.setAttribute('stroke', '#E2E0DA');
          n.querySelector('.fc-inner')?.setAttribute('r', '4');
          n.querySelector('.fc-inner')?.setAttribute('fill', '#71727A');
          n.querySelector('.fc-inner')?.removeAttribute('filter');
          const label = n.querySelector('.fc-label');
          if (label) {
            label.classList.remove('fill-[#5B7FA0]', 'font-semibold');
            label.classList.add('fill-[#2A2B2E]');
          }
        });

        // Activate current
        node.querySelector('.fc-outer')?.setAttribute('r', '18');
        node.querySelector('.fc-outer')?.setAttribute('stroke', '#5B7FA0');
        node.querySelector('.fc-inner')?.setAttribute('r', '6');
        node.querySelector('.fc-inner')?.setAttribute('fill', '#5B7FA0');
        node.querySelector('.fc-inner')?.setAttribute('filter', 'url(#accentGlow)');
        const label = node.querySelector('.fc-label');
        if (label) {
          label.classList.remove('fill-[#2A2B2E]');
          label.classList.add('fill-[#5B7FA0]', 'font-semibold');
        }

        if (techDisplay) techDisplay.innerText = node.getAttribute('data-node-tech') || '';
        if (descDisplay) descDisplay.innerText = `${node.getAttribute('data-node-label')}: ${node.getAttribute('data-node-sub')}`;
      };

      const deactivate = () => {
        // Reset to default
        node.querySelector('.fc-outer')?.setAttribute('r', '14');
        node.querySelector('.fc-outer')?.setAttribute('stroke', '#E2E0DA');
        node.querySelector('.fc-inner')?.setAttribute('r', '4');
        node.querySelector('.fc-inner')?.setAttribute('fill', '#71727A');
        node.querySelector('.fc-inner')?.removeAttribute('filter');
        const label = node.querySelector('.fc-label');
        if (label) {
          label.classList.remove('fill-[#5B7FA0]', 'font-semibold');
          label.classList.add('fill-[#2A2B2E]');
        }

        if (techDisplay) techDisplay.innerText = defaultTech;
        if (descDisplay) descDisplay.innerText = defaultMessage;
      };

      node.addEventListener('mouseenter', activate);
      node.addEventListener('mouseleave', deactivate);
      node.addEventListener('click', activate);
    });
  };

  document.addEventListener('DOMContentLoaded', setupFlowchart);
  document.addEventListener('astro:page-load', setupFlowchart);
</script>

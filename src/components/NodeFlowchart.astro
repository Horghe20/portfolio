---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  highlightedAudience?: 'all' | 'azienda' | 'recruiter' | 'dev';
}

const { highlightedAudience = 'all' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const nodes = [
  {
    id: 0, x: 80, y: 70, t: 0,
    label: '1. Requisiti', sub: 'Interviste / User Stories',
    tech: 'Interviste / User Stories',
    labelY: 40, subY: 52
  },
  {
    id: 1, x: 255, y: 70, t: 1,
    label: '2. Analisi', sub: 'Modellazione / Vincoli',
    tech: 'Modellazione / Vincoli',
    labelY: 40, subY: 52
  },
  {
    id: 2, x: 430, y: 70, t: 2,
    label: '3. Implementazione', sub: 'Flask / Angular / Java',
    tech: 'Flask / Angular / Java',
    labelY: 40, subY: 52
  },
  {
    id: 3, x: 430, y: 170, t: 2.57,
    label: 'Motore AI & Solver', sub: 'OR-Tools / NLP / kNN / LLMs API',
    tech: 'OR-Tools / NLP / kNN / LLMs API',
    labelY: 200, subY: 212
  },
  {
    id: 4, x: 605, y: 70, t: 3,
    label: '4. Delivery', sub: 'CI/CD / Docker / Test automatici',
    tech: 'CI/CD / Docker / Test automatici',
    labelY: 40, subY: 52
  },
  {
    id: 5, x: 780, y: 70, t: 4,
    label: '5. Manutenzione', sub: 'Monitoring / Alerting',
    tech: 'Monitoring / Alerting',
    labelY: 40, subY: 52
  }
];

const defaultMessage = lang === 'it' ? 'Dai requisiti al rilascio continuo in produzione.' : 'From initial needs to continuous production release.';
const mainPath = "M 80 70 L 780 70";
const fullPath = "M 80 70 L 780 70 M 430 70 L 430 170";
---

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  @keyframes nodePulseOuter {
    0%, 15%, 100% { stroke: var(--color-border); r: 14px; }
    5% { stroke: var(--color-accent); r: 17px; }
  }
  @keyframes nodePulseInner {
    0%, 15%, 100% { fill: var(--color-text-dim); r: 4px; }
    5% { fill: var(--color-accent); r: 6px; }
  }
  @keyframes nodePulseLabel {
    0%, 15%, 100% { fill: var(--color-text); }
    5% { fill: var(--color-accent); font-weight: 600; }
  }
  
  .animate-pulse-outer { animation: nodePulseOuter 4s linear infinite; }
  .animate-pulse-inner { animation: nodePulseInner 4s linear infinite; }
  .animate-pulse-label { animation: nodePulseLabel 4s linear infinite; }

  /* Hover overrides */
  .flowchart-node.node-active .fc-outer, .flowchart-node:hover .fc-outer {
    stroke: var(--color-accent) !important;
    r: 18px !important;
    animation: none;
  }
  .flowchart-node.node-active .fc-inner, .flowchart-node:hover .fc-inner {
    fill: var(--color-accent) !important;
    r: 6px !important;
    filter: url(#accentGlow) !important;
    animation: none;
  }
  .flowchart-node.node-active .fc-label, .flowchart-node:hover .fc-label {
    fill: var(--color-accent) !important;
    font-weight: 600 !important;
    animation: none;
  }
</style>

<div id="flowchart-section" class="w-full relative">
  <div class="w-full max-w-3xl mx-auto my-4 p-4 rounded-xl bg-surface border border-border shadow-sm relative overflow-hidden backdrop-blur-sm group" id="flowchart-container" data-default-message={defaultMessage}>
    <div class="flex items-center justify-between mb-3 px-2 relative z-10">
      <div class="flex items-center space-x-2">
        <span class="inline-block w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        <span class="text-xs font-mono text-text-dim uppercase tracking-wider">
          {t('hero.flowchart.tag')}
        </span>
        <span class="sm:hidden text-[10px] font-mono text-accent flex items-center space-x-1 pl-1">
          <span>•</span>
          <span>{lang === 'it' ? 'Scorri il flusso →' : 'Swipe flow →'}</span>
        </span>
      </div>
      <span class="text-[11px] font-mono text-accent bg-accent-soft px-2 py-0.5 rounded border border-border" id="flowchart-tech">
        {t('hero.flowchart.hint')}
      </span>
    </div>

    <div class="relative w-full overflow-x-auto overscroll-x-contain pb-2 cursor-grab active:cursor-grabbing no-scrollbar touch-pan-x select-none" id="flowchart-scroll-container" style="-webkit-overflow-scrolling: touch; scrollbar-width: none;">
      <div class="min-w-[760px] sm:min-w-0 w-full h-[220px] sm:h-[240px] mx-auto relative">
        <!-- Gradient masks for scroll indication on mobile -->
        <div id="flowchart-fade-left" class="absolute inset-y-0 left-0 w-8 bg-gradient-to-r from-surface to-transparent z-10 pointer-events-none sm:hidden opacity-0 transition-opacity duration-200"></div>
        <div id="flowchart-fade-right" class="absolute inset-y-0 right-0 w-12 bg-gradient-to-l from-surface to-transparent z-10 pointer-events-none sm:hidden opacity-100 transition-opacity duration-200"></div>
        
        <svg 
          viewBox="0 0 860 240" 
          class="w-full h-full overflow-visible"
        >
            <defs>
              <linearGradient id="accentLineGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0.4" />
                <stop offset="50%" stop-color="var(--color-accent)" stop-opacity="1" />
                <stop offset="100%" stop-color="var(--color-accent)" stop-opacity="0.5" />
              </linearGradient>

              <filter id="accentGlow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="2.5" result="blur" />
                <feComposite in="SourceGraphic" in2="blur" operator="over" />
              </filter>

              <pattern id="gridPattern" width="24" height="24" patternUnits="userSpaceOnUse">
                <path d="M 24 0 L 0 0 0 24" fill="none" stroke="currentColor" stroke-width="1" class="text-text-dim" />
              </pattern>
            </defs>

            <!-- Background Blueprint Grid -->
            <rect width="100%" height="100%" fill="url(#gridPattern)" class="opacity-[0.04] pointer-events-none" />

            <!-- Background Connecting Path (Orthogonal) -->
            <path
              d={fullPath}
              fill="none"
              style="stroke: var(--color-border);"
              stroke-width="2"
            />

            <!-- Animated Main Line -->
            <path
              id="flowchart-animated-line"
              d={fullPath}
              fill="none"
              stroke="url(#accentLineGradient)"
              stroke-width="2.5"
              stroke-dasharray="1000"
              stroke-dashoffset="1000"
              class="transition-all duration-1000 ease-out motion-reduce:stroke-dashoffset-0"
            />

            <!-- Traveling Signal Pulse -->
            <circle r="4" style="fill: var(--color-accent);" filter="url(#accentGlow)" class="motion-reduce:hidden opacity-0" id="flowchart-pulse">
              <animateMotion
                path={mainPath}
                dur="4s"
                repeatCount="indefinite"
              />
            </circle>

            <!-- Traveling Signal Pulse Branch (AI) -->
            <circle r="4" style="fill: var(--color-accent);" filter="url(#accentGlow)" class="motion-reduce:hidden opacity-0" id="flowchart-pulse-branch">
              <animate
                attributeName="opacity"
                values="0; 0; 1; 1; 0; 0"
                keyTimes="0; 0.499; 0.5; 0.642; 0.643; 1"
                dur="4s"
                repeatCount="indefinite"
              />
              <animateMotion
                path="M 430 70 L 430 170"
                dur="4s"
                keyTimes="0; 0.5; 0.6428; 1"
                keyPoints="0; 0; 1; 1"
                calcMode="linear"
                repeatCount="indefinite"
              />
            </circle>

            <!-- Nodes -->
            {nodes.map((node) => (
              <g 
                class="flowchart-node cursor-pointer transition-transform duration-200"
                data-node-id={node.id}
                data-node-tech={node.tech}
                data-node-label={node.label}
                data-node-sub={node.sub}
              >
                <!-- Outer Ring -->
                <circle
                  cx={node.x}
                  cy={node.y}
                  r="14"
                  style={`fill: var(--color-surface); stroke: var(--color-border); animation-delay: ${node.t}s;`}
                  stroke-width="2"
                  class="fc-outer transition-all duration-200 animate-pulse-outer"
                />

                <!-- Inner Core -->
                <circle
                  cx={node.x}
                  cy={node.y}
                  r="4"
                  style={`fill: var(--color-text-dim); animation-delay: ${node.t}s;`}
                  class="fc-inner transition-all duration-200 animate-pulse-inner"
                />

                <!-- Label -->
                <text
                  x={node.x}
                  y={node.labelY}
                  text-anchor="middle"
                  class="fc-label text-[11px] font-sans font-medium transition-all duration-200 animate-pulse-label"
                  style={`fill: var(--color-text); animation-delay: ${node.t}s;`}
                >
                  {node.label}
                </text>

                <!-- Sub Badge -->
                <text
                  x={node.x}
                  y={node.subY}
                  text-anchor="middle"
                  class="text-[9px] font-mono"
                  style="fill: var(--color-text-dim);"
                >
                  {node.sub}
                </text>
              </g>
            ))}
          </svg>
        </div>
      </div>

      <!-- Active node detail prompt -->
      <div class="mt-1 pt-2 border-t border-border flex items-center justify-between text-xs text-text-dim relative z-10">
        <span class="truncate" id="flowchart-desc">
          {defaultMessage}
        </span>
      </div>
    </div>
</div>

<script>
  const setupFlowchart = () => {
    const container = document.getElementById('flowchart-container');
    const scrollContainer = document.getElementById('flowchart-scroll-container');
    if (!container || !scrollContainer) return;

    const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const line = document.getElementById('flowchart-animated-line');
    const pulse = document.getElementById('flowchart-pulse');
    const pulseBranch = document.getElementById('flowchart-pulse-branch');
    const nodes = document.querySelectorAll('.flowchart-node');
    const techDisplay = document.getElementById('flowchart-tech');
    const descDisplay = document.getElementById('flowchart-desc');
    const defaultMessage = container.getAttribute('data-default-message') || '';
    const defaultTech = techDisplay ? techDisplay.innerText : '';
    const fadeLeft = document.getElementById('flowchart-fade-left');
    const fadeRight = document.getElementById('flowchart-fade-right');

    if (!isReducedMotion && line && pulse) {
      setTimeout(() => {
        line.style.strokeDashoffset = '0';
        pulse.classList.remove('opacity-0');
        if (pulseBranch) pulseBranch.classList.remove('opacity-0');
      }, 150);
    }

    // Node click and hover interactions
    nodes.forEach(node => {
      const activate = () => {
        nodes.forEach(n => n.classList.remove('node-active'));
        node.classList.add('node-active');
        if (techDisplay) techDisplay.innerText = node.getAttribute('data-node-tech') || '';
        if (descDisplay) descDisplay.innerText = `${node.getAttribute('data-node-label')}: ${node.getAttribute('data-node-sub')}`;
      };

      const deactivate = () => {
        node.classList.remove('node-active');
        if (techDisplay) techDisplay.innerText = defaultTech;
        if (descDisplay) descDisplay.innerText = defaultMessage;
      };

      node.addEventListener('mouseenter', activate);
      node.addEventListener('mouseleave', deactivate);
      node.addEventListener('click', (e) => {
        e.stopPropagation();
        activate();
      });
    });

    // Mobile scroll indicator fade logic
    const updateFades = () => {
      const scrollLeft = scrollContainer.scrollLeft;
      const maxScroll = scrollContainer.scrollWidth - scrollContainer.clientWidth;

      if (fadeLeft) {
        if (scrollLeft > 15) {
          fadeLeft.classList.remove('opacity-0');
          fadeLeft.classList.add('opacity-100');
        } else {
          fadeLeft.classList.remove('opacity-100');
          fadeLeft.classList.add('opacity-0');
        }
      }

      if (fadeRight) {
        if (maxScroll - scrollLeft > 15) {
          fadeRight.classList.remove('opacity-0');
          fadeRight.classList.add('opacity-100');
        } else {
          fadeRight.classList.remove('opacity-100');
          fadeRight.classList.add('opacity-0');
        }
      }
    };

    scrollContainer.addEventListener('scroll', updateFades, { passive: true });
    updateFades();

    // Mouse drag-to-scroll support (for desktop/trackpad)
    let isDown = false;
    let startX = 0;
    let scrollStart = 0;

    scrollContainer.addEventListener('mousedown', (e) => {
      isDown = true;
      scrollContainer.classList.add('cursor-grabbing');
      startX = e.pageX - scrollContainer.offsetLeft;
      scrollStart = scrollContainer.scrollLeft;
    });

    window.addEventListener('mouseup', () => {
      isDown = false;
      scrollContainer.classList.remove('cursor-grabbing');
    });

    scrollContainer.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - scrollContainer.offsetLeft;
      const walk = (x - startX) * 1.5;
      scrollContainer.scrollLeft = scrollStart - walk;
    });
  };

  document.addEventListener('DOMContentLoaded', setupFlowchart);
  document.addEventListener('astro:page-load', setupFlowchart);
</script>

---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations, getRelativeLocaleUrl } from '../i18n/utils';
import NodeFlowchart from './NodeFlowchart.astro';
import { PERSONAL_INFO } from '../data/content';
import profileImage from '../assets/profile.jpg';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const audienceChips = [
  {
    id: 'azienda',
    labelKey: 'hero.audience.azienda',
    icon: 'tabler:building-skyscraper',
    targetSection: 'services',
    tooltip: lang === 'it' ? 'Ottimizza processi, riduci costi e automatizza workflow.' : 'Streamline ops, cut costs, and automate workflows.'
  },
  {
    id: 'recruiter',
    labelKey: 'hero.audience.recruiter',
    icon: 'tabler:user-check',
    targetSection: 'timeline',
    tooltip: lang === 'it' ? 'Profilo, competenze tecniche, tesi e certificazioni.' : 'Experience, technical stack, thesis, and credentials.'
  },
  {
    id: 'dev',
    labelKey: 'hero.audience.dev',
    icon: 'tabler:terminal-2',
    targetSection: 'laboratory',
    tooltip: lang === 'it' ? 'Architetture, codice, solver OR-Tools e sistemi embedded.' : 'Architecture, solver algorithms, and bare metal specs.'
  }
];
---

<section id="hero" class="relative pt-24 pb-12 sm:pt-28 sm:pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto flex flex-col items-center text-center">
  
  <!-- Background glow gradient subtle effect -->
  <div class="absolute top-12 left-1/2 -translate-x-1/2 w-3/4 max-w-3xl h-64 bg-accent/5 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <!-- Top Status Capsule -->
  <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-surface border border-border mb-6 text-xs font-mono text-text-dim hover:border-accent/40 transition-colors shadow-xs">
    <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
    <span class="text-text font-medium">
      {t('hero.badgeTitle')}
    </span>
    <span class="text-border">•</span>
    <span>{t('hero.badgeSubtitle')}</span>
  </div>

  <!-- Profile Image -->
  <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full border-4 border-surface shadow-xl relative z-10 mx-auto flex items-center justify-center bg-surface-2 overflow-hidden mb-6">
    <Image 
      src={profileImage} 
      alt="Giorgio Di Cristofalo" 
      width={256}
      height={256}
      class="w-full h-full object-cover"
      loading="eager"
      format="webp"
    />
  </div>

  <!-- Main Headline -->
  <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold leading-tight mb-5 tracking-tighter max-w-4xl text-text">
    {t('hero.headlinePrefix')}<br />
    <span class="text-accent">{t('hero.headlineSuffix')}</span>
  </h1>

  <!-- Subtitle / Value Positioning -->
  <p class="text-text-dim text-base sm:text-lg max-w-2xl mb-8 leading-relaxed font-sans">
    {t('hero.subtitle')}
  </p>

  <!-- Audience Self-Selection Chips -->
  <div class="flex flex-wrap items-center justify-center gap-2 mb-10">
    {audienceChips.map((chip) => (
      <a
        href={getRelativeLocaleUrl(lang, `/#${chip.targetSection}`)}
        title={chip.tooltip}
        class="px-3.5 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase transition-all cursor-pointer border bg-surface text-text-dim border-border hover:text-text hover:bg-surface-2"
      >
        {t(chip.labelKey)}
      </a>
    ))}
  </div>

  <!-- Primary Action Buttons & Social Icons -->
  <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 mb-10">
    <a
      href={getRelativeLocaleUrl(lang, '/#contact')}
      class="bg-accent text-accent-contrast px-8 py-3 font-bold rounded-sm hover:opacity-90 transition-all shadow-xs flex items-center space-x-2 cursor-pointer"
    >
      <span>{t('hero.ctaCollaborate')}</span>
      <Icon name="tabler:arrow-down" class="w-4 h-4" />
    </a>

    <a
      href={getRelativeLocaleUrl(lang, '/#laboratory')}
      class="bg-surface text-text border border-border hover:border-accent hover:bg-surface-2 px-6 py-3 font-semibold text-sm rounded-sm transition-all flex items-center space-x-2 cursor-pointer shadow-xs"
    >
      <Icon name="tabler:code" class="w-4 h-4 text-accent" />
      <span>{t('hero.ctaLaboratory')}</span>
    </a>

    <div class="flex items-center gap-3">
      <a
        href={PERSONAL_INFO.github}
        target="_blank"
        rel="noreferrer"
        class="w-10 h-10 rounded-full bg-surface border border-border hover:border-accent hover:text-accent flex items-center justify-center text-text-dim transition-all shadow-xs"
        title="GitHub"
      >
        <Icon name="tabler:brand-github" class="w-5 h-5" />
      </a>
      <a
        href={PERSONAL_INFO.linkedin}
        target="_blank"
        rel="noreferrer"
        class="w-10 h-10 rounded-full bg-surface border border-border hover:border-accent hover:text-accent flex items-center justify-center text-text-dim transition-all shadow-xs"
        title="LinkedIn"
      >
        <Icon name="tabler:brand-linkedin" class="w-5 h-5" />
      </a>
    </div>
  </div>

  <!-- Minimal Node Flowchart Visual -->
  <div class="w-full max-w-3xl mb-8">
    <NodeFlowchart highlightedAudience="all" />
  </div>

  <!-- Small subtle footer in hero: Location and Trust -->
  <div class="flex items-center space-x-4 text-xs font-mono text-text-dim pt-2">
    <span class="flex items-center space-x-1">
      <Icon name="tabler:map-pin" class="w-3.5 h-3.5 text-accent" />
      <span>{t('hero.location')}</span>
    </span>
    <span class="text-border">•</span>
    <span class="text-text">{t('hero.credentials')}</span>
  </div>

</section>

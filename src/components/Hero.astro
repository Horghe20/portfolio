---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations, getRelativeLocaleUrl } from '../i18n/utils';
import NodeFlowchart from './NodeFlowchart.astro';
import { PERSONAL_INFO } from '../data/content';
import profileImage from '../assets/profile.jpg';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const audienceChips = [
  {
    id: 'azienda',
    labelKey: 'hero.audience.azienda',
    icon: 'tabler:building-skyscraper',
    targetSection: 'services',
    tooltip: lang === 'it' ? 'Ottimizza processi, riduci costi e automatizza workflow.' : 'Streamline ops, cut costs, and automate workflows.'
  },
  {
    id: 'recruiter',
    labelKey: 'hero.audience.recruiter',
    icon: 'tabler:user-check',
    targetSection: 'timeline',
    tooltip: lang === 'it' ? 'Profilo, competenze tecniche, tesi e certificazioni.' : 'Experience, technical stack, thesis, and credentials.'
  },
  {
    id: 'dev',
    labelKey: 'hero.audience.dev',
    icon: 'tabler:terminal-2',
    targetSection: 'laboratory',
    tooltip: lang === 'it' ? 'Architetture, codice, solver OR-Tools e sistemi embedded.' : 'Architecture, solver algorithms, and bare metal specs.'
  }
];
---

<section id="hero" class="relative pt-12 pb-12 sm:pt-16 sm:pb-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto flex flex-col items-center text-center">
  
  <!-- Asymmetric Mesh Glow & Engineering Geometric Grid -->
  <div class="absolute -top-10 right-0 sm:right-10 w-96 h-96 bg-accent/15 rounded-full blur-3xl pointer-events-none -z-10 animate-pulse" style="animation-duration: 8s;"></div>
  <div class="absolute top-36 -left-20 w-80 h-80 bg-accent/10 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute inset-x-0 top-0 h-[520px] pointer-events-none -z-10 opacity-[0.035] [background-image:linear-gradient(to_right,var(--color-text)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-text)_1px,transparent_1px)] [background-size:32px_32px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_25%,#000_70%,transparent_100%)]"></div>

  <!-- Top Status Capsule -->
  <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-surface border border-border mb-6 text-xs font-mono text-text-dim hover:border-accent/40 transition-colors shadow-xs">
    <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
    <span class="text-text font-medium">
      {t('hero.badgeTitle')}
    </span>
    <span class="text-border">•</span>
    <span>{t('hero.badgeSubtitle')}</span>
  </div>

  <!-- Profile Image with Subtle 3D Depth Ring -->
  <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full border-2 border-border p-1 bg-surface-2 shadow-xl relative z-10 mx-auto flex items-center justify-center overflow-hidden mb-6 transition-transform duration-300 hover:scale-105 group">
    <div class="w-full h-full rounded-full overflow-hidden bg-surface relative">
      <Image 
        src={profileImage} 
        alt="Giorgio Di Cristofalo" 
        width={256}
        height={256}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
        loading="eager"
        format="webp"
      />
    </div>
  </div>

  <!-- Main Headline -->
  <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold leading-tight mb-5 tracking-tighter max-w-4xl text-text text-balance">
    {t('hero.headlinePrefix')}<br />
    <span class="text-accent">{t('hero.headlineSuffix')}</span>
  </h1>

  <!-- Subtitle / Value Positioning -->
  <p class="text-text-dim text-base sm:text-lg max-w-2xl mb-8 leading-relaxed font-sans text-pretty">
    {t('hero.subtitle')}
  </p>

  <!-- Audience Self-Selection Chips -->
  <div class="flex flex-wrap items-center justify-center gap-2 mb-8">
    {audienceChips.map((chip) => (
      <a
        href={getRelativeLocaleUrl(lang, `/#${chip.targetSection}`)}
        title={chip.tooltip}
        class="px-3.5 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase transition-all duration-150 cursor-pointer border bg-surface text-text-dim border-border hover:text-text hover:bg-surface-2 active:scale-95"
      >
        {t(chip.labelKey)}
      </a>
    ))}
  </div>

  <!-- Social Icons -->
  <div class="flex items-center justify-center gap-4 mb-8">
    <a
      href={PERSONAL_INFO.github}
      target="_blank"
      rel="noreferrer"
      class="w-10 h-10 rounded-full bg-surface border border-border hover:border-accent hover:text-accent flex items-center justify-center text-text-dim transition-colors shadow-xs active:scale-95"
      title="GitHub"
      aria-label="Profilo GitHub di Giorgio Di Cristofalo"
    >
      <Icon name="tabler:brand-github" class="w-5 h-5" />
    </a>
    <a
      href={PERSONAL_INFO.linkedin}
      target="_blank"
      rel="noreferrer"
      class="w-10 h-10 rounded-full bg-surface border border-border hover:border-accent hover:text-accent flex items-center justify-center text-text-dim transition-colors shadow-xs active:scale-95"
      title="LinkedIn"
      aria-label="Profilo LinkedIn di Giorgio Di Cristofalo"
    >
      <Icon name="tabler:brand-linkedin" class="w-5 h-5" />
    </a>
  </div>

  <!-- Primary Action Buttons with 10% Accent on CTA -->
  <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 mb-12">
    <a
      href={getRelativeLocaleUrl(lang, '/#contact')}
      class="bg-accent text-accent-contrast px-8 py-3.5 font-bold rounded-lg hover:brightness-110 active:scale-95 transition-all shadow-[0_4px_20px_rgba(27,59,111,0.25)] flex items-center space-x-2 cursor-pointer focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
    >
      <span>{t('hero.ctaCollaborate')}</span>
      <Icon name="tabler:arrow-down" class="w-4 h-4" />
    </a>

    <a
      href={getRelativeLocaleUrl(lang, '/#timeline')}
      class="bg-surface text-text border border-border hover:border-accent/60 hover:bg-surface-2 px-6 py-3.5 font-semibold text-sm rounded-lg active:scale-95 transition-all flex items-center space-x-2 cursor-pointer shadow-xs focus-visible:ring-2 focus-visible:ring-border focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
    >
      <Icon name="tabler:briefcase" class="w-4 h-4 text-accent" />
      <span>{t('hero.ctaLaboratory')}</span>
    </a>
  </div>

  <!-- 3D Interactive Perspective Architecture Card -->
  <div class="w-full max-w-4xl mx-auto mb-8 perspective-1000 group/stage">
    <div 
      id="hero-3d-card"
      class="relative rounded-2xl bg-surface/90 border border-border p-2 sm:p-4 shadow-2xl transition-all duration-300 ease-out will-change-transform [transform-style:preserve-3d]"
      style="transform: rotateX(5deg) rotateY(-3deg) translateZ(0);"
    >
      <!-- Top Window Header Bar -->
      <div class="flex items-center justify-between px-3 py-2 border-b border-border/80 mb-2">
        <div class="flex items-center space-x-2">
          <div class="w-2.5 h-2.5 rounded-full bg-[#FF5F56]/80"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E]/80"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-[#27C93F]/80"></div>
          <span class="text-[11px] font-mono text-text-dim ml-2 flex items-center space-x-1">
            <Icon name="tabler:cpu" class="w-3.5 h-3.5 text-accent" />
            <span>architecture_pipeline.sys</span>
          </span>
        </div>
        <div class="flex items-center space-x-2 text-[10px] font-mono text-text-dim">
          <span class="hidden sm:inline-block px-2 py-0.5 rounded bg-surface-2 border border-border">AI & OR-Tools Runtime</span>
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
        </div>
      </div>

      <!-- Flowchart inside 3D Card -->
      <div class="w-full">
        <NodeFlowchart highlightedAudience="all" />
      </div>
    </div>
  </div>

  <!-- Client-side Interactive 3D Tilt Script (Degrada con grazia su mobile/reduced-motion) -->
  <script is:inline>
    (function() {
      const card = document.getElementById('hero-3d-card');
      if (!card) return;

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReduced || window.innerWidth < 768) {
        card.style.transform = 'none';
        return;
      }

      const stage = card.parentElement;
      let bounds;

      function updateBounds() {
        bounds = stage.getBoundingClientRect();
      }

      function onMouseMove(e) {
        if (!bounds) updateBounds();
        const mouseX = e.clientX - bounds.left;
        const mouseY = e.clientY - bounds.top;
        const xPct = (mouseX / bounds.width) - 0.5;
        const yPct = (mouseY / bounds.height) - 0.5;

        const rotX = -(yPct * 10);
        const rotY = (xPct * 12);

        card.style.transform = `rotateX(${rotX.toFixed(2)}deg) rotateY(${rotY.toFixed(2)}deg) scale3d(1.01, 1.01, 1.01)`;
      }

      function onMouseLeave() {
        card.style.transform = 'rotateX(5deg) rotateY(-3deg) scale3d(1, 1, 1)';
      }

      stage.addEventListener('mouseenter', updateBounds);
      stage.addEventListener('mousemove', onMouseMove);
      stage.addEventListener('mouseleave', onMouseLeave);
      window.addEventListener('resize', updateBounds);
    })();
  </script>

</section>

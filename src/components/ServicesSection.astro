---
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations, getRelativeLocaleUrl } from '../i18n/utils';
import { SERVICES } from '../data/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const getIcon = (iconName: string) => {
  switch (iconName) {
    case 'Terminal':
      return 'tabler:terminal-2';
    case 'Layers':
      return 'tabler:layers-intersect';
    case 'Cpu':
      return 'tabler:cpu';
    default:
      return 'tabler:terminal-2';
  }
};
---

<section id="services" class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  
  <!-- Section Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 border-b border-border pb-6">
    <div>
      <span class="text-xs font-bold uppercase tracking-widest text-text-dim flex items-center space-x-1.5 mb-2">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent"></span>
        <span>{t('services.tag')}</span>
      </span>
      <h2 class="text-3xl sm:text-5xl font-bold text-text tracking-tight">
        {t('services.title')}
      </h2>
    </div>
    <p class="text-sm text-text-dim max-w-md mt-2 md:mt-0">
      {t('services.subtitle')}
    </p>
  </div>

  <!-- 3 Outcome-Driven Cards Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-12">
    {SERVICES.map((service) => (
      <div class="rounded-lg bg-surface border border-border p-6 sm:p-7 flex flex-col justify-between card-hover transition-all group shadow-xs">
        <div>
          <!-- Header with Icon -->
          <div class="flex items-center justify-between mb-5">
            <div class="w-10 h-10 rounded-lg bg-surface-2 border border-border flex items-center justify-center group-hover:border-accent transition-colors">
              <Icon name={getIcon(service.icon)} class="w-5 h-5 text-accent" />
            </div>
            <span class="text-[11px] font-mono text-text-dim bg-surface-2 px-2.5 py-1 rounded border border-border">
              {service.id === 'automation-delivery' ? '01 // OPS' : service.id === 'fullstack-dev' ? '02 // DEV' : '03 // AI'}
            </span>
          </div>

          <!-- Title & Description -->
          <h3 class="font-bold text-xl text-text mb-3 group-hover:text-accent transition-colors">
            {typeof service.title === 'object' ? service.title[lang] : service.title}
          </h3>
          <p class="text-xs sm:text-sm text-text-dim leading-relaxed mb-6 font-normal">
            {typeof service.description === 'object' ? service.description[lang] : service.description}
          </p>

          <!-- Key Bullet Points -->
          <div class="space-y-2.5 mb-6 pt-4 border-t border-border">
            {(typeof service.keyPoints === 'object' ? service.keyPoints[lang] : service.keyPoints).map((point: string) => (
              <div class="flex items-start space-x-2.5 text-xs text-text">
                <Icon name="tabler:circle-check" class="w-4 h-4 text-accent shrink-0 mt-0.5" />
                <span>{point}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Bottom Proof and Laboratory Link -->
        <div class="pt-4 border-t border-border mt-auto">
          <div class="bg-surface-2 p-3 rounded border border-border mb-3">
            <span class="text-[10px] font-mono text-text-dim block uppercase tracking-wider mb-1">
              {lang === 'it' ? 'Prova sul campo:' : 'Real-world proof:'}
            </span>
            <p class="text-xs text-text italic font-sans">
              "{typeof service.proof === 'object' ? service.proof[lang] : service.proof}"
            </p>
          </div>

          <a
            href={getRelativeLocaleUrl(lang, `/projects/${service.linkedProjectId}`)}
            class="w-full flex items-center justify-between text-xs font-mono text-accent hover:text-text transition-colors py-1 group/btn cursor-pointer font-medium"
          >
            <span>{t('services.learnMore')}</span>
            <Icon name="tabler:arrow-right" class="w-3.5 h-3.5 group-hover/btn:translate-x-1 transition-transform" />
          </a>
        </div>
      </div>
    ))}
  </div>

  <!-- Punchline Banner -->
  <div class="rounded-lg bg-surface border border-border p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xs">
    <div class="space-y-1 text-center sm:text-left">
      <p class="font-bold text-lg sm:text-xl text-text">
        {t('services.talkTitle')}
      </p>
      <p class="text-xs font-mono text-text-dim">
        {t('services.talkSubtitle')}
      </p>
    </div>

    <a
      href={getRelativeLocaleUrl(lang, '/#contact')}
      class="shrink-0 px-6 py-2.5 rounded-sm bg-accent text-accent-contrast font-bold text-xs hover:opacity-90 transition-all shadow-xs cursor-pointer"
    >
      {t('services.talkCta')}
    </a>
  </div>

</section>

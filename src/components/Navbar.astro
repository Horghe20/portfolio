---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations, getRelativeLocaleUrl } from '../i18n/utils';
import logoImage from '../assets/logo.png';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const otherLang = lang === 'it' ? 'en' : 'it';
const otherLangUrl = getRelativeLocaleUrl(otherLang, Astro.url.pathname.replace(/^\/(en|it)/, '') || '/');

const navLinks = [
  { id: 'services', labelKey: 'nav.services' },
  { id: 'laboratory', labelKey: 'nav.projects' },
  { id: 'timeline', labelKey: 'nav.timeline' },
  { id: 'faq-aeo', labelKey: 'nav.faq' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-surface/90 backdrop-blur-md border-b border-border transition-all duration-200" id="navbar">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    
    <!-- Brand / Logo -->
    <a 
      href={getRelativeLocaleUrl(lang, '/#hero')}
      class="flex items-center space-x-3 group cursor-pointer"
      id="brand-logo-link"
    >
      <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm shadow-xs transition-all bg-surface-2 overflow-hidden border border-border group-hover:border-accent" id="nav-logo-box">
        <Image 
          src={logoImage} 
          alt="GDC Logo" 
          width={64}
          height={64}
          class="w-full h-full object-cover"
          format="webp"
        />
      </div>
      <div class="flex flex-col">
        <span class="font-bold tracking-tight text-base sm:text-lg text-text group-hover:text-accent transition-colors">
          Giorgio Di Cristofalo
        </span>
        <span class="text-[10px] font-mono text-text-dim hidden sm:block">
          {t('nav.roleSubtitle')}
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center space-x-2 lg:space-x-4 text-sm font-medium">
      {navLinks.map((link) => (
        <a
          href={getRelativeLocaleUrl(lang, `/#${link.id}`)}
          data-nav-target={link.id}
          class="nav-link relative px-3.5 py-1.5 rounded-md text-xs sm:text-sm font-medium transition-all duration-200 cursor-pointer text-text-dim hover:text-text hover:bg-surface-2 border border-transparent"
        >
          <span>{t(link.labelKey)}</span>
          <span class="nav-indicator hidden absolute -bottom-1 left-3 right-3 h-[2px] bg-accent rounded-full"></span>
        </a>
      ))}
    </nav>

    <!-- Right Actions: Lang Toggle & CTA -->
    <div class="hidden sm:flex items-center space-x-4">
      <!-- Language Toggle -->
      <div class="flex items-center px-2 py-1 border border-border rounded bg-surface-2 text-xs font-mono">
        <a
          href={getRelativeLocaleUrl('it', Astro.url.pathname.replace(/^\/(en|it)/, '') || '/')}
          class={`lang-toggle cursor-pointer transition-colors ${lang === 'it' ? 'text-accent font-bold' : 'text-text-dim hover:text-text opacity-70'}`}
          data-lang="it"
          title="Italiano"
        >
          IT
        </a>
        <span class="opacity-40 mx-1.5 text-text-dim">|</span>
        <a
          href={getRelativeLocaleUrl('en', Astro.url.pathname.replace(/^\/(en|it)/, '') || '/')}
          class={`lang-toggle cursor-pointer transition-colors ${lang === 'en' ? 'text-accent font-bold' : 'text-text-dim hover:text-text opacity-70'}`}
          data-lang="en"
          title="English"
        >
          EN
        </a>
      </div>

      <!-- Contact Button -->
      <a
        href={getRelativeLocaleUrl(lang, '/#contact')}
        data-nav-target="contact"
        class="nav-cta inline-flex items-center space-x-1.5 px-4 py-1.5 rounded-sm font-bold text-xs shadow-xs transition-all cursor-pointer bg-accent text-accent-contrast hover:opacity-90"
      >
        <span>{t('nav.contact')}</span>
        <Icon name="tabler:arrow-up-right" class="w-3.5 h-3.5" />
      </a>
    </div>

    <!-- Mobile menu trigger -->
    <div class="flex items-center space-x-2 md:hidden">
      <!-- Language toggle for mobile -->
      <div class="flex items-center bg-surface-2 border border-border rounded px-2 py-1 text-xs font-mono mr-1">
        <a
          href={otherLangUrl}
          class="lang-toggle text-accent font-bold flex items-center space-x-1"
          data-lang={otherLang}
        >
          <Icon name="tabler:world" class="w-3 h-3 text-accent" />
          <span>{lang.toUpperCase()}</span>
        </a>
      </div>

      <button
        id="mobile-menu-btn"
        class="p-2 rounded bg-surface-2 text-text-dim hover:text-text border border-border cursor-pointer"
        aria-label="Toggle mobile menu"
      >
        <Icon name="tabler:menu-2" class="w-5 h-5 text-text-dim" id="menu-icon-open" />
        <Icon name="tabler:x" class="w-5 h-5 text-text hidden" id="menu-icon-close" />
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu-drawer" class="hidden md:hidden bg-surface border-b border-border px-4 pt-3 pb-5 space-y-2">
    <div class="space-y-1">
      {navLinks.map((link) => (
        <a
          href={getRelativeLocaleUrl(lang, `/#${link.id}`)}
          data-nav-target={link.id}
          class="mobile-nav-link w-full text-left px-3.5 py-2.5 text-sm font-medium rounded transition-all flex items-center justify-between text-text-dim hover:text-text hover:bg-surface-2"
        >
          <span>{t(link.labelKey)}</span>
          <span class="mobile-nav-indicator hidden w-1.5 h-1.5 rounded-full bg-accent"></span>
        </a>
      ))}
    </div>

    <div class="pt-3 border-t border-border flex items-center justify-between">
      <div class="flex items-center space-x-2 text-xs font-mono text-text-dim">
        <span class="w-2 h-2 rounded-full bg-accent"></span>
        <span>{lang === 'it' ? 'Disponibile per progetti' : 'Available for work'}</span>
      </div>

      <a
        href={getRelativeLocaleUrl(lang, '/#contact')}
        data-nav-target="contact"
        class="mobile-nav-cta px-4 py-2 rounded-sm text-xs font-bold transition-all cursor-pointer bg-accent text-accent-contrast hover:opacity-90"
      >
        {t('hero.ctaCollaborate')}
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile Menu Toggle
  const btn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-menu-drawer');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  
  if (btn && drawer && iconOpen && iconClose) {
    btn.addEventListener('click', () => {
      drawer.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });

    // Close on link click
    drawer.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        drawer.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      });
    });
  }

  // Active section highlighting based on IntersectionObserver
  const setupIntersectionObserver = () => {
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('.nav-link');
    const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
    const navLogoBox = document.getElementById('nav-logo-box');
    const ctas = document.querySelectorAll('.nav-cta, .mobile-nav-cta');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          
          // Reset all
          navLinks.forEach(link => {
            link.classList.remove('text-accent', 'font-semibold', 'bg-accent-soft', 'border-accent/30', 'shadow-xs');
            link.classList.add('text-text-dim', 'hover:text-text', 'border-transparent');
            link.querySelector('.nav-indicator')?.classList.add('hidden');
          });
          
          mobileNavLinks.forEach(link => {
            link.classList.remove('text-accent', 'font-semibold', 'bg-accent-soft', 'border-l-2', 'border-accent');
            link.classList.add('text-text-dim', 'hover:text-text');
            link.querySelector('.mobile-nav-indicator')?.classList.add('hidden');
          });

          // Handle active logo
          if (navLogoBox) {
            if (id === 'hero') {
              navLogoBox.classList.add('bg-accent', 'text-accent-contrast', 'ring-2', 'ring-accent/30');
              navLogoBox.classList.remove('bg-surface-2', 'text-text', 'border-border');
            } else {
              navLogoBox.classList.remove('bg-accent', 'text-accent-contrast', 'ring-2', 'ring-accent/30');
              navLogoBox.classList.add('bg-surface-2', 'text-text', 'border-border');
            }
          }

          // Handle active CTA (contact)
          ctas.forEach(cta => {
            if (id === 'contact') {
              cta.classList.add('ring-2', 'ring-accent', 'ring-offset-2', 'ring-offset-surface', 'shadow-md');
            } else {
              cta.classList.remove('ring-2', 'ring-accent', 'ring-offset-2', 'ring-offset-surface', 'shadow-md');
            }
          });

          // Activate current
          const activeNav = document.querySelector(`.nav-link[data-nav-target="${id}"]`);
          if (activeNav) {
            activeNav.classList.remove('text-text-dim', 'hover:text-text', 'border-transparent');
            activeNav.classList.add('text-accent', 'font-semibold', 'bg-accent-soft', 'border-accent/30', 'shadow-xs');
            activeNav.querySelector('.nav-indicator')?.classList.remove('hidden');
          }

          const activeMobileNav = document.querySelector(`.mobile-nav-link[data-nav-target="${id}"]`);
          if (activeMobileNav) {
            activeMobileNav.classList.remove('text-text-dim', 'hover:text-text');
            activeMobileNav.classList.add('text-accent', 'font-semibold', 'bg-accent-soft', 'border-l-2', 'border-accent');
            activeMobileNav.querySelector('.mobile-nav-indicator')?.classList.remove('hidden');
          }
        }
      });
    }, { threshold: 0, rootMargin: "-20% 0px -60% 0px" });

    sections.forEach(section => observer.observe(section));
  };

  // Language preference saving
  const langToggles = document.querySelectorAll('.lang-toggle');
  langToggles.forEach(toggle => {
    toggle.addEventListener('click', (e) => {
      const selectedLang = toggle.getAttribute('data-lang');
      if (selectedLang) {
        localStorage.setItem('lang-pref', selectedLang);
      }
    });
  });

  // Run on load and after Astro swaps
  document.addEventListener('DOMContentLoaded', setupIntersectionObserver);
  document.addEventListener('astro:page-load', () => {
    setupIntersectionObserver();
    
    // Re-attach language listeners on page load for view transitions
    document.querySelectorAll('.lang-toggle').forEach(toggle => {
      toggle.addEventListener('click', (e) => {
        const selectedLang = toggle.getAttribute('data-lang');
        if (selectedLang) {
          localStorage.setItem('lang-pref', selectedLang);
        }
      });
    });
  });
</script>

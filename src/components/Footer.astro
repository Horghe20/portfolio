---
import { Icon } from 'astro-icon/components';
import { getLangFromUrl } from '../i18n/utils';
import { PERSONAL_INFO } from '../data/content';

const lang = getLangFromUrl(Astro.url);
---

<footer class="border-t border-border bg-surface py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    
    <!-- Brand & Bio -->
    <div class="flex flex-col items-center md:items-start text-center md:text-left space-y-1.5">
      <div class="flex items-center space-x-2">
        <span class="w-2 h-2 rounded-full bg-accent"></span>
        <span class="font-bold text-sm text-text">
          Giorgio Di Cristofalo
        </span>
      </div>
      <p class="text-xs font-mono text-text-dim">
        {lang === 'it' 
          ? 'Software Engineer • Automazione, Delivery & AI Applicata' 
          : 'Software Engineer • Automation, Delivery & Applied AI'}
      </p>
      <span class="text-[11px] font-mono text-text-dim">
        Palermo, Sicilia • IDSAirnav (ENAV) • Faidda Tech Lab
      </span>
    </div>

    <!-- Social Links -->
    <div class="flex items-center space-x-6 text-xs font-mono text-text-dim">
      <a
        href={PERSONAL_INFO.github}
        target="_blank"
        rel="noreferrer"
        class="hover:text-accent transition-colors flex items-center space-x-1"
      >
        <Icon name="tabler:brand-github" class="w-3.5 h-3.5" />
        <span>GitHub</span>
      </a>
      <a
        href={PERSONAL_INFO.linkedin}
        target="_blank"
        rel="noreferrer"
        class="hover:text-accent transition-colors flex items-center space-x-1"
      >
        <Icon name="tabler:brand-linkedin" class="w-3.5 h-3.5" />
        <span>LinkedIn</span>
      </a>
      <a
        href={PERSONAL_INFO.community}
        target="_blank"
        rel="noreferrer"
        class="hover:text-accent transition-colors flex items-center space-x-1"
      >
        <span>Faidda Tech Lab</span>
        <Icon name="tabler:external-link" class="w-3 h-3" />
      </a>
    </div>

    <!-- Back to top & Copyright -->
    <div class="flex items-center space-x-4">
      <span class="text-xs font-mono text-text-dim">
        © {new Date().getFullYear()}
      </span>

      <button
        id="back-to-top-btn"
        class="p-2 rounded-sm bg-surface-2 border border-border text-text-dim hover:text-accent hover:border-accent transition-colors cursor-pointer shadow-xs"
        aria-label="Back to top"
      >
        <Icon name="tabler:arrow-up" class="w-4 h-4" />
      </button>
    </div>

  </div>
</footer>

<script>
  const setupBackToTop = () => {
    const btn = document.getElementById('back-to-top-btn');
    if (btn) {
      btn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  };

  document.addEventListener('DOMContentLoaded', setupBackToTop);
  document.addEventListener('astro:page-load', setupBackToTop);
</script>
